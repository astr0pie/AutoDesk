<%- include('../partials/header') %>
<div class="max-w-md mx-auto my-8 bg-white p-8 rounded-xl border border-slate-200 shadow-sm">
    <h2 class="text-2xl font-bold text-brandBlue mb-2">Registrasi User Baru</h2>
    <p class="text-xs text-slate-500 mb-6">Buat akun pegawai atau admin baru untuk Login.</p>
    
    <!-- Box Error Dinamis (Tampil saat validasi gagal) -->
    <div id="errorAlert" class="hidden p-3 mb-4 text-xs text-rose-700 bg-rose-100 rounded-lg">
        <% if(error) { %><%= error %><% } %>
    </div>
    <% if(error) { %>
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                const alert = document.getElementById('errorAlert');
                alert.classList.remove('hidden');
                alert.innerText = "<%= error %>";
            });
        </script>
    <% } %>

    <form action="/register" method="POST" onsubmit="return validateForm()" class="space-y-4">
        <!-- Username -->
        <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Username</label>
            <input type="text" id="usernameInput" name="username" value="<%= typeof formData !== 'undefined' && formData.username ? formData.username : '' %>" required placeholder="Contoh: pegawai123" 
                class="w-full p-2.5 text-sm border border-slate-300 rounded-lg focus:border-brandBlue focus:outline-none font-mono">
            <p id="usernameNote" class="text-[11px] text-slate-400 mt-1">
                💡 Minimal 4 karakter, hanya kombinasi huruf dan angka.
            </p>
        </div>

        <!-- Nama Lengkap -->
        <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Nama Lengkap</label>
            <input type="text" name="nama" value="<%= typeof formData !== 'undefined' && formData.nama ? formData.nama : '' %>" required placeholder="Masukkan nama lengkap Anda" class="w-full p-2.5 text-sm border border-slate-300 rounded-lg focus:border-brandBlue focus:outline-none">
        </div>

        <!-- Seksi / Unit Kerja -->
        <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Seksi / Unit Kerja</label>
            <select name="nama_seksi" required class="w-full p-2.5 text-sm border border-slate-300 rounded-lg focus:border-brandBlue focus:outline-none bg-white">
                <option value="" disabled <%= (typeof formData === 'undefined' || !formData.nama_seksi) ? 'selected' : '' %>>-- Pilih Seksi / Unit Kerja --</option>
                <option value="Pelayanan" <%= (typeof formData !== 'undefined' && formData.nama_seksi === 'Pelayanan') ? 'selected' : '' %>>Pelayanan</option>
                <option value="Penjaminan Kualitas Data" <%= (typeof formData !== 'undefined' && formData.nama_seksi === 'Penjaminan Kualitas Data') ? 'selected' : '' %>>Penjaminan Kualitas Data</option>
                <option value="Pemeriksaan, Penagihan, dan Penilaian" <%= (typeof formData !== 'undefined' && formData.nama_seksi === 'Pemeriksaan, Penagihan, dan Penilaian') ? 'selected' : '' %>>Pemeriksaan, Penagihan, dan Penilaian</option>
                <option value="Pengawasan I" <%= (typeof formData !== 'undefined' && formData.nama_seksi === 'Pengawasan I') ? 'selected' : '' %>>Pengawasan I</option>
                <option value="Pengawasan II" <%= (typeof formData !== 'undefined' && formData.nama_seksi === 'Pengawasan II') ? 'selected' : '' %>>Pengawasan II</option>
                <option value="Pengawasan III" <%= (typeof formData !== 'undefined' && formData.nama_seksi === 'Pengawasan III') ? 'selected' : '' %>>Pengawasan III</option>
                <option value="Pengawasan IV" <%= (typeof formData !== 'undefined' && formData.nama_seksi === 'Pengawasan IV') ? 'selected' : '' %>>Pengawasan IV</option>
                <option value="Pengawasan V" <%= (typeof formData !== 'undefined' && formData.nama_seksi === 'Pengawasan V') ? 'selected' : '' %>>Pengawasan V</option>
                <option value="Pengawasan VI" <%= (typeof formData !== 'undefined' && formData.nama_seksi === 'Pengawasan VI') ? 'selected' : '' %>>Pengawasan VI</option>
                <option value="Subbagian Umum dan Kepatuhan Internal" <%= (typeof formData !== 'undefined' && formData.nama_seksi === 'Subbagian Umum dan Kepatuhan Internal') ? 'selected' : '' %>>Subbagian Umum dan Kepatuhan Internal</option>
            </select>
        </div>

        <!-- Password -->
        <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Password</label>
            <div class="relative">
                <input type="password" id="regPassword" name="password" required class="w-full p-2.5 pr-10 text-sm border border-slate-300 rounded-lg focus:border-brandBlue focus:outline-none">
                <button type="button" onclick="togglePassword('regPassword', 'eyeIcon1')" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 focus:outline-none">
                    <svg id="eyeIcon1" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                </button>
            </div>
        </div>

        <!-- Konfirmasi Password -->
        <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Konfirmasi Password</label>
            <div class="relative">
                <input type="password" id="confirmPassword" name="confirm_password" required class="w-full p-2.5 pr-10 text-sm border border-slate-300 rounded-lg focus:border-brandBlue focus:outline-none">
                <button type="button" onclick="togglePassword('confirmPassword', 'eyeIcon2')" class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 focus:outline-none">
                    <svg id="eyeIcon2" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                    </svg>
                </button>
            </div>
        </div>

        <!-- Role -->
        <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Daftar Sebagai (Role)</label>
            <select name="role" id="roleSelect" onchange="toggleAdminCode()" class="w-full p-2.5 text-sm border border-slate-300 rounded-lg focus:border-brandBlue focus:outline-none bg-white">
                <option value="pegawai" <%= (typeof formData !== 'undefined' && formData.role === 'pegawai') ? 'selected' : '' %>>Pegawai Kantor</option>
                <option value="admin" <%= (typeof formData !== 'undefined' && formData.role === 'admin') ? 'selected' : '' %>>Admin Operasional</option>
            </select>
        </div>

        <!-- Secret Code Input (Khusus Admin) -->
        <div id="adminCodeGroup" class="<%= (typeof formData !== 'undefined' && formData.role === 'admin') ? '' : 'hidden' %> pt-2 border-t border-slate-100">
            <label class="block text-xs font-semibold text-amber-800 mb-1">Secret Code Admin</label>
            <input type="password" name="admin_code" id="adminCodeInput" value="<%= typeof formData !== 'undefined' && formData.admin_code ? formData.admin_code : '' %>" placeholder="Masukkan Kode Admin" class="w-full p-2.5 text-sm border border-amber-300 bg-amber-50 rounded-lg focus:outline-none">
        </div>

        <button type="submit" class="w-full py-2.5 bg-brandYellow hover:bg-yellow-500 text-slate-900 font-bold text-sm rounded-lg transition mt-2">Daftar Akun</button>
    </form>
    <p class="text-xs text-center text-slate-600 mt-4">Sudah punya akun? <a href="/login" class="text-brandBlue font-bold underline">Login</a></p>
</div>

<script>
function togglePassword(inputId, iconId) {
    const pwdInput = document.getElementById(inputId);
    const eyeIcon = document.getElementById(iconId);
    if (pwdInput.type === 'password') {
        pwdInput.type = 'text';
        eyeIcon.classList.add('text-brandBlue');
    } else {
        pwdInput.type = 'password';
        eyeIcon.classList.remove('text-brandBlue');
    }
}

function toggleAdminCode() {
    const role = document.getElementById('roleSelect').value;
    const codeGroup = document.getElementById('adminCodeGroup');
    if (role === 'admin') {
        codeGroup.classList.remove('hidden');
    } else {
        codeGroup.classList.add('hidden');
    }
}

function validateForm() {
    const username = document.getElementById('usernameInput').value;
    const usernameInput = document.getElementById('usernameInput');
    const usernameNote = document.getElementById('usernameNote');
    const errorAlert = document.getElementById('errorAlert');

    const pwd = document.getElementById('regPassword').value;
    const confirmPwd = document.getElementById('confirmPassword').value;

    // Reset Style Error
    usernameInput.classList.remove('border-rose-500', 'bg-rose-50', 'text-rose-600');
    usernameInput.classList.add('border-slate-300');
    usernameNote.classList.remove('text-rose-500', 'font-semibold');
    usernameNote.classList.add('text-slate-400');
    errorAlert.classList.add('hidden');

    // 1. Validasi Username (Min 4 Karakter, Alphanumeric saja)
    const usernameRegex = /^[a-zA-Z0-9]{4,}$/;
    if (!usernameRegex.test(username)) {
        usernameInput.classList.remove('border-slate-300');
        usernameInput.classList.add('border-rose-500', 'bg-rose-50', 'text-rose-600');
        usernameNote.classList.remove('text-slate-400');
        usernameNote.classList.add('text-rose-500', 'font-semibold');

        errorAlert.innerText = "Username minimal 4 karakter dan hanya boleh terdiri dari huruf dan angka!";
        errorAlert.classList.remove('hidden');

        window.scrollTo({ top: 0, behavior: 'smooth' });
        return false;
    }

    // 2. Validasi Konfirmasi Password
    if (pwd !== confirmPwd) {
        errorAlert.innerText = "Konfirmasi password tidak cocok!";
        errorAlert.classList.remove('hidden');

        window.scrollTo({ top: 0, behavior: 'smooth' });
        return false;
    }

    return true;
}
</script>
<%- include('../partials/footer') %>