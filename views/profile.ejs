<%- include('partials/header') %>
<div class="max-w-xl mx-auto my-10 bg-white border border-slate-200 rounded-xl p-8 shadow-sm">
    <div class="flex items-center space-x-4 mb-6">
        <div class="w-16 h-16 bg-brandBlue text-brandYellow font-bold text-2xl rounded-full flex items-center justify-center">
            <%= user.nama.charAt(0) %>
        </div>
        <div>
            <h2 class="text-2xl font-bold text-slate-900"><%= user.nama %></h2>
            <p class="text-xs text-slate-500">@<%= user.username %></p>
            <span class="px-2.5 py-0.5 bg-blue-100 text-brandBlue text-xs font-bold rounded-full uppercase inline-block mt-1"><%= user.role %></span>
        </div>
    </div>
    <div class="space-y-4 text-sm divide-y divide-slate-100">
        <div class="pt-2 flex justify-between"><span class="text-slate-500">Username:</span><strong class="text-slate-800">@<%= user.username %></strong></div>
        <div class="pt-2 flex justify-between"><span class="text-slate-500">Nama Lengkap:</span><strong class="text-slate-800"><%= user.nama %></strong></div>
        <div class="pt-2 flex justify-between"><span class="text-slate-500">Tipe Akses:</span><strong class="text-slate-800 uppercase"><%= user.role %></strong></div>
    </div>
</div>
<%- include('partials/footer') %>