<%- include('partials/header') %>
<div class="max-w-xl mx-auto my-6 sm:my-10 bg-white border border-slate-200 rounded-xl p-6 sm:p-8 shadow-sm">
    <div class="flex items-center space-x-4 mb-6">
        <div class="w-14 h-14 sm:w-16 sm:h-16 bg-brandBlue text-brandYellow font-bold text-2xl rounded-full flex items-center justify-center shrink-0">
            <%= user.nama.charAt(0) %>
        </div>
        <div class="min-w-0">
            <h2 class="text-xl sm:text-2xl font-bold text-slate-900 truncate"><%= user.nama %></h2>
            <p class="text-xs text-slate-500 font-mono">@<%= user.username %></p>
            <span class="px-2.5 py-0.5 bg-blue-100 text-brandBlue text-[10px] sm:text-xs font-bold rounded-full uppercase inline-block mt-1"><%= user.role %></span>
        </div>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
        <div class="p-3 mb-4 text-xs text-emerald-800 bg-emerald-100 rounded-lg"><%= success %></div>
    <% } %>
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="p-3 mb-4 text-xs text-rose-800 bg-rose-100 rounded-lg"><%= error %></div>
    <% } %>

    <!-- Form Edit Profil -->
    <form action="/profile/edit" method="POST" class="space-y-4">
        <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Username</label>
            <input type="text" name="username" value="<%= user.username %>" required class="w-full p-2.5 text-xs sm:text-sm border border-slate-300 rounded-lg focus:border-brandBlue focus:outline-none">
        </div>
        <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Nama Lengkap</label>
            <input type="text" name="nama" value="<%= user.nama %>" required class="w-full p-2.5 text-xs sm:text-sm border border-slate-300 rounded-lg focus:border-brandBlue focus:outline-none">
        </div>
        <div>
            <label class="block text-xs font-semibold text-slate-700 mb-1">Seksi / Unit Kerja</label>
            <select name="nama_seksi" required class="w-full p-2.5 text-xs sm:text-sm border border-slate-300 rounded-lg focus:border-brandBlue focus:outline-none bg-white">
                <option value="Seksi Pelayanan" <%= user.nama_seksi === 'Seksi Pelayanan' ? 'selected' : '' %>>Seksi Pelayanan</option>
                <option value="Seksi Penjaminan Kualitas Data" <%= user.nama_seksi === 'Seksi Penjaminan Kualitas Data' ? 'selected' : '' %>>Seksi Penjaminan Kualitas Data</option>
                <option value="Seksi Pemeriksaan, Penagihan, dan Penilaian" <%= user.nama_seksi === 'Seksi Pemeriksaan, Penagihan, dan Penilaian' ? 'selected' : '' %>>Seksi Pemeriksaan, Penagihan, dan Penilaian</option>
                <option value="Seksi Pengawasan I" <%= user.nama_seksi === 'Seksi Pengawasan I' ? 'selected' : '' %>>Seksi Pengawasan I</option>
                <option value="Seksi Pengawasan II" <%= user.nama_seksi === 'Seksi Pengawasan II' ? 'selected' : '' %>>Seksi Pengawasan II</option>
                <option value="Seksi Pengawasan III" <%= user.nama_seksi === 'Seksi Pengawasan III' ? 'selected' : '' %>>Seksi Pengawasan III</option>
                <option value="Seksi Pengawasan IV" <%= user.nama_seksi === 'Seksi Pengawasan IV' ? 'selected' : '' %>>Seksi Pengawasan IV</option>
                <option value="Seksi Pengawasan V" <%= user.nama_seksi === 'Seksi Pengawasan V' ? 'selected' : '' %>>Seksi Pengawasan V</option>
                <option value="Seksi Pengawasan VI" <%= user.nama_seksi === 'Seksi Pengawasan VI' ? 'selected' : '' %>>Seksi Pengawasan VI</option>
                <option value="Subbagian Umum dan Kepatuhan Internal" <%= user.nama_seksi === 'Subbagian Umum dan Kepatuhan Internal' ? 'selected' : '' %>>Subbagian Umum dan Kepatuhan Internal</option>
            </select>
        </div>

        <button type="submit" class="w-full py-2.5 bg-brandBlue hover:bg-blue-800 text-white font-bold text-xs sm:text-sm rounded-lg transition mt-2">
            Simpan Perubahan Profil
        </button>
    </form>
</div>
<%- include('partials/footer') %>