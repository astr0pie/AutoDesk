<%- include('partials/header') %>

<div class="max-w-xl mx-auto my-6 sm:my-10 px-4">
    <div class="bg-white border border-slate-200 rounded-2xl p-5 sm:p-8 shadow-sm">
        <h1 class="text-xl sm:text-2xl font-bold text-brandBlue mb-1">Pengaturan Profil</h1>
        <p class="text-xs sm:text-sm text-slate-500 mb-6">Kelola informasi identitas akun Anda.</p>

        <% if (error) { %>
            <div class="mb-4 p-3 bg-rose-50 border border-rose-200 text-rose-700 text-xs sm:text-sm rounded-lg">
                <%= error %>
            </div>
        <% } %>

        <% if (success) { %>
            <div class="mb-4 p-3 bg-emerald-50 border border-emerald-200 text-emerald-700 text-xs sm:text-sm rounded-lg">
                <%= success %>
            </div>
        <% } %>

        <form action="/profile/update" method="POST" class="space-y-4">
            <!-- Nama Lengkap -->
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Nama Lengkap</label>
                <input type="text" name="nama" value="<%= user.nama %>" required 
                    class="w-full p-2.5 text-xs sm:text-sm border border-slate-300 rounded-lg focus:outline-none focus:border-brandBlue">
            </div>

            <!-- Username -->
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Username</label>
                <input type="text" id="usernameInput" name="username" value="<%= user.username %>" required 
                    minlength="4" pattern="[a-zA-Z0-9]+" title="Minimal 4 karakter, hanya huruf dan angka"
                    class="w-full p-2.5 text-xs sm:text-sm border border-slate-300 rounded-lg focus:outline-none focus:border-brandBlue font-mono">
                <p class="text-[11px] text-slate-400 mt-1">💡 Minimal 4 karakter, hanya kombinasi huruf dan angka.</p>
            </div>

            <!-- Seksi / Unit Kerja -->
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Seksi / Unit Kerja</label>
                <input type="text" name="nama_seksi" value="<%= user.nama_seksi || '' %>" placeholder="Contoh: Subbagian Umum / Seksi Pengawasan" 
                    class="w-full p-2.5 text-xs sm:text-sm border border-slate-300 rounded-lg focus:outline-none focus:border-brandBlue">
            </div>

            <!-- Field Konfirmasi Password (Otomatis Muncul Jika Username Diubah) -->
            <div id="passwordConfirmBox" class="pt-2 border-t border-slate-100 hidden">
                <label class="block text-xs font-bold text-rose-600 mb-1">Konfirmasi Password *</label>
                <input type="password" id="passwordConfirmInput" name="password_confirm" placeholder="Masukkan password Anda saat ini" 
                    class="w-full p-2.5 text-xs sm:text-sm border border-rose-300 rounded-lg focus:outline-none focus:border-rose-500 bg-rose-50/30">
                <p class="text-[11px] text-rose-500 mt-1">Password akun wajib diisi untuk mengonfirmasi perubahan username.</p>
            </div>

            <div class="pt-4 flex justify-end gap-3 border-t">
                <a href="/dashboard" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs sm:text-sm rounded-lg transition">Batal</a>
                <button type="submit" class="px-5 py-2 bg-brandBlue hover:bg-blue-800 text-white font-bold text-xs sm:text-sm rounded-lg transition">Simpan Perubahan</button>
            </div>
        </form>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const usernameInput = document.getElementById('usernameInput');
    const passwordConfirmBox = document.getElementById('passwordConfirmBox');
    const passwordConfirmInput = document.getElementById('passwordConfirmInput');
    const initialUsername = "<%= user.username %>";

    usernameInput.addEventListener('input', function() {
        if (this.value.trim() !== initialUsername) {
            passwordConfirmBox.classList.remove('hidden');
            passwordConfirmInput.setAttribute('required', 'required');
        } else {
            passwordConfirmBox.classList.add('hidden');
            passwordConfirmInput.removeAttribute('required');
            passwordConfirmInput.value = '';
        }
    });
});
</script>

<%- include('partials/footer') %>