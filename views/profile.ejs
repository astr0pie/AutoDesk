<%- include('partials/header') %>

<div class="max-w-xl mx-auto my-4 sm:my-8">
    <div class="card p-5 sm:p-8">
        <!-- Identitas singkat -->
        <div class="flex items-center gap-4 mb-6 pb-6 border-b border-slate-200">
            <span class="avatar" style="width:3.25rem;height:3.25rem;font-size:1.25rem;" aria-hidden="true"><%= String(user.nama || user.username || '?').trim().charAt(0).toUpperCase() %></span>
            <div class="min-w-0">
                <h1 class="page-title truncate" style="font-size:1.375rem;">Pengaturan Profil</h1>
                <p class="page-sub" style="margin-top:.2rem;">Kelola informasi identitas akun Anda.</p>
            </div>
        </div>

        <% if (error) { %>
            <div class="alert alert-error mb-4" role="alert">
                <%= error %>
            </div>
        <% } %>

        <% if (success) { %>
            <div class="alert alert-success mb-4" role="status">
                <%= success %>
            </div>
        <% } %>

        <form action="/profile/update" method="POST" class="space-y-4">
            <!-- Nama Lengkap -->
            <div>
                <label for="namaInput" class="label">Nama Lengkap</label>
                <input type="text" id="namaInput" name="nama" value="<%= user.nama %>" required autocomplete="name" class="field">
            </div>

            <!-- Username -->
            <div>
                <label for="usernameInput" class="label">Username</label>
                <input type="text" id="usernameInput" name="username" value="<%= user.username %>" required
                    minlength="4" pattern="[a-zA-Z0-9]+" title="Minimal 4 karakter, hanya huruf dan angka" autocomplete="username" autocapitalize="none"
                    class="field field-mono">
                <p class="hint">Minimal 4 karakter, hanya kombinasi huruf dan angka.</p>
            </div>

            <!-- Seksi / Unit Kerja -->
            <div>
                <label for="seksiInput" class="label">Seksi / Unit Kerja</label>
                <input type="text" id="seksiInput" name="nama_seksi" value="<%= user.nama_seksi || '' %>" placeholder="Contoh: Subbagian Umum / Seksi Pengawasan" class="field">
            </div>

            <!-- Field Konfirmasi Password (Otomatis Muncul Jika Username Diubah) -->
            <div id="passwordConfirmBox" class="pt-4 border-t border-slate-200 hidden">
                <label for="passwordConfirmInput" class="label" style="color:#BE123C;">Konfirmasi Password *</label>
                <input type="password" id="passwordConfirmInput" name="password_confirm" placeholder="Masukkan password Anda saat ini" autocomplete="current-password" class="field field-danger">
                <p class="hint" style="color:#BE123C;">Password akun wajib diisi untuk mengonfirmasi perubahan username.</p>
            </div>

            <div class="pt-5 flex justify-end gap-3 border-t border-slate-200">
                <a href="/dashboard" class="btn btn-ghost">Batal</a>
                <button type="submit" class="btn btn-primary">Simpan Perubahan</button>
            </div>
        </form>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const usernameInput = document.getElementById('usernameInput');
    const passwordConfirmBox = document.getElementById('passwordConfirmBox');
    const passwordConfirmInput = document.getElementById('passwordConfirmInput');
    const initialUsername = "<%= user.username %>";

    usernameInput.addEventListener('input', function() {
        if (this.value.trim() !== initialUsername) {
            passwordConfirmBox.classList.remove('hidden');
            passwordConfirmInput.setAttribute('required', 'required');
        } else {
            passwordConfirmBox.classList.add('hidden');
            passwordConfirmInput.removeAttribute('required');
            passwordConfirmInput.value = '';
        }
    });
});
</script>

<%- include('partials/footer') %>
