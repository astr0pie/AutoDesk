<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Peminjaman Kendaraan Dinas KPP Pratama Kotabumi</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brandBlue: '#1E40AF',
                        brandYellow: '#FACC15',
                        brandBg: '#FFFFFF',
                        brandCard: '#F8FAFC'
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-brandBg text-slate-800 font-sans min-h-screen flex flex-col">
    <nav class="bg-white border-b-4 border-brandYellow shadow-sm sticky top-0 z-40">
        <div class="max-w-7xl mx-auto px-3 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16 gap-2">
                <!-- Logo & Judul Aplikasi -->
                <a href="/dashboard" class="flex items-center space-x-2 sm:space-x-3 hover:opacity-90 transition min-w-0">
                    <img src="/images/kemenkeu.png" alt="Logo Kemenkeu" class="w-8 h-8 sm:w-10 sm:h-10 object-contain shrink-0">
                    <span class="text-xs sm:text-base md:text-lg font-bold text-brandBlue truncate">Peminjaman Kendaraan Dinas KPP Pratama Kotabumi</span>
                </a>

                <!-- Navigasi User Login -->
                <% if (user) { %>
                <div class="flex items-center space-x-2 sm:space-x-4 shrink-0">
                    <span class="text-xs sm:text-sm text-slate-600 hidden md:inline"><strong class="text-brandBlue"></strong></span>
                    <a href="/dashboard" class="text-xs sm:text-sm font-semibold text-slate-700 hover:text-brandBlue transition">Dashboard</a>
                    <a href="/profile" class="text-xs sm:text-sm font-semibold text-slate-700 hover:text-brandBlue transition">Profil</a>
                    <a href="/logout" class="px-2.5 py-1 sm:px-3 sm:py-1.5 text-xs sm:text-sm bg-rose-50 text-rose-600 rounded-md font-medium hover:bg-rose-100 transition">Logout</a>
                </div>
                <% } %>
            </div>
        </div>
    </nav>
    <main class="flex-grow max-w-7xl w-full mx-auto p-3 sm:p-6 lg:p-8">