<%- include('partials/header') %>

<!-- Flatpickr CSS & JS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<style>
  .flatpickr-calendar {
    font-family: inherit !important;
    border-radius: 14px !important;
    box-shadow: 0 18px 40px -10px rgba(14, 42, 92, 0.3) !important;
    border: 1px solid #DCE2EC !important;
    z-index: 9999 !important;
  }
  .flatpickr-current-month {
    font-family: inherit !important;
    font-weight: 700 !important;
    font-size: 0.95rem !important;
  }
  .flatpickr-current-month .flatpickr-monthDropdown-months,
  .flatpickr-current-month input.cur-year {
    font-family: inherit !important;
    font-weight: 700 !important;
  }
  .flatpickr-day.selected,
  .flatpickr-day.selected:hover {
    background: #1E40AF !important;
    border-color: #1E40AF !important;
    color: #fff !important;
  }
  .flatpickr-day.today:not(.selected) {
    border-color: #FACC15 !important;
  }
  .flatpickr-day.booked-date {
    background-color: #fef08a !important;
    color: #854d0e !important;
    font-weight: 700 !important;
    border-radius: 9999px !important;
    border: 1px solid #fde047 !important;
    max-width: 28px !important;
    height: 28px !important;
    line-height: 26px !important;
    margin: 2px auto !important;
  }
</style>

<div class="mb-6 sm:mb-8">
    <h1 class="page-title">Dashboard Peminjaman Mobil</h1>
    <p class="page-sub">Pilih unit kendaraan dinas dan atur jadwal peminjaman Anda.</p>
</div>

<!-- Daftar Mobil -->
<section class="mb-10" aria-labelledby="armadaTitle">
    <h2 id="armadaTitle" class="section-title mb-4">Status Kendaraan Operasional<span class="count-chip"><%= mobilList.length %> unit</span></h2>

    <% if (mobilList.length === 0) { %>
        <div class="card p-8 text-center text-sm text-slate-500">Belum ada unit kendaraan yang terdaftar.</div>
    <% } %>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
        <% mobilList.forEach(m => { %>
        <article class="car-card">
            <div class="car-top">
                <span class="plate"><%= m.plat_nomor %></span>
                <% if(m.is_booked || m.status === 'DIPINJAM') { %>
                    <span class="badge badge-busy">Booked</span>
                <% } else if(m.status === 'FREE') { %>
                    <span class="badge badge-free">FREE</span>
                <% } else { %>
                    <span class="badge badge-maint">MAINTENANCE</span>
                <% } %>
            </div>

            <div>
                <h3 class="car-name"><%= m.merk_tipe %></h3>
            </div>

            <dl class="spec">
                <div><dt>Kategori</dt><dd><%= m.kategori %></dd></div>
                <div><dt>Kapasitas</dt><dd><%= m.kapasitas %> Seat</dd></div>
            </dl>

            <p class="car-note"><strong>Catatan Kondisi:</strong> <%= m.kondapat_catatan || 'Siap pakai' %></p>

            <div class="car-actions">
                <button type="button"
                    data-id="<%= m.id %>" data-merk="<%= m.merk_tipe %>" data-plat="<%= m.plat_nomor %>"
                    onclick="openDetailModal(this.dataset.id, this.dataset.merk, this.dataset.plat)"
                    class="btn btn-ghost btn-block">
                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 6.75h12M8.25 12h12m-12 5.25h12M3.75 6.75h.007v.008H3.75V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM3.75 12h.007v.008H3.75V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm-.375 5.25h.007v.008H3.75v-.008zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/></svg>
                    Detail Peminjam &amp; Jadwal
                </button>
                <button type="button"
                    data-id="<%= m.id %>" data-merk="<%= m.merk_tipe %>" data-plat="<%= m.plat_nomor %>"
                    onclick="openBookingModal(this.dataset.id, this.dataset.merk, this.dataset.plat)"
                    class="btn btn-primary btn-block">
                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/></svg>
                    Ajukan Pinjaman / Booking
                </button>
            </div>
        </article>
        <% }) %>
    </div>
</section>

<!-- MODAL 1: Detail Peminjam & Jadwal Booking -->
<div id="detailModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center z-50 p-3 sm:p-4">
    <div class="modal-panel max-w-lg max-h-[85vh] overflow-y-auto" role="dialog" aria-modal="true" aria-labelledby="detailMobilTitle">
        <div class="modal-head">
            <div class="min-w-0">
                <h3 id="detailMobilTitle" class="modal-title truncate"></h3>
                <p id="detailMobilPlat" class="plate plate-sm mt-1"></p>
            </div>
            <button type="button" onclick="closeDetailModal()" class="icon-btn" aria-label="Tutup">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>

        <div class="space-y-4">
            <!-- Tombol Cek Tanggal Ter-booking -->
            <div>
                <button id="pegawaiCalendarBtn" type="button" class="w-full py-2.5 px-4 bg-slate-100 border border-slate-300 rounded-lg text-slate-900 font-bold text-xs hover:bg-slate-200 transition text-left flex items-center justify-between">
                    <span>📅 Melihat Tanggal Ter-booking</span>
                    <span class="text-slate-500 font-normal text-[11px]">Klik untuk lihat kalender</span>
                </button>
                <input type="text" id="pegawaiCalendarView" class="hidden">
            </div>

            <div>
                <h4 class="label mb-2">Daftar Rincian Peminjam</h4>
                <div id="jadwalContainer">
                    <p class="text-xs text-slate-400">Memuat data jadwal...</p>
                </div>
            </div>
        </div>

        <div class="modal-foot">
            <button type="button" onclick="closeDetailModal()" class="btn btn-ghost">Tutup</button>
        </div>
    </div>
</div>

<!-- MODAL 2: Form Ajukan Pinjaman / Booking -->
<div id="bookingModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center z-50 p-3 sm:p-4">
    <div class="modal-panel max-w-md max-h-[90vh] overflow-y-auto" role="dialog" aria-modal="true" aria-labelledby="bookingMobilTitle">
        <div class="modal-head">
            <div class="min-w-0">
                <h3 id="bookingMobilTitle" class="modal-title truncate">Form Peminjaman</h3>
                <p id="bookingMobilPlat" class="plate plate-sm mt-1"></p>
            </div>
            <button type="button" onclick="closeBookingModal()" class="icon-btn" aria-label="Tutup">
                <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
            </button>
        </div>

        <form action="/dashboard/pinjam" method="POST" class="space-y-4">
            <input type="hidden" id="booking_mobil_id" name="mobil_id">

            <div>
                <label for="tujuanInput" class="label">Tujuan Dinas / Kegiatan</label>
                <input type="text" id="tujuanInput" name="tujuan" required placeholder="Contoh: Pendampingan Pemeriksaan Lapangan" class="field">
            </div>

            <div class="notice">
                <p class="font-bold mb-1">Catatan Pemilih Tanggal</p>
                <p>Tanggal berlatar <strong>kuning</strong> menunjukkan mobil sudah ter-booking. Pemilihan tanggal maksimal <strong>7 hari</strong> dari hari ini.</p>
            </div>

            <div>
                <label for="tgl_mulai_picker" class="label">Tanggal &amp; Waktu Mulai</label>
                <input type="text" id="tgl_mulai_picker" name="tgl_mulai" required placeholder="Pilih Tanggal Mulai" class="field cursor-pointer">
            </div>

            <div>
                <label for="tgl_selesai_picker" class="label">Tanggal &amp; Waktu Selesai</label>
                <input type="text" id="tgl_selesai_picker" name="tgl_selesai" required placeholder="Pilih Tanggal Selesai" class="field cursor-pointer">
            </div>

            <div class="modal-foot" style="margin-top:1.25rem;">
                <button type="button" onclick="closeBookingModal()" class="btn btn-ghost">Batal</button>
                <button type="submit" class="btn btn-primary">Kirim Pengajuan</button>
            </div>
        </form>
    </div>
</div>

<!-- Riwayat Peminjaman Pegawai -->
<section class="card p-4 sm:p-6" aria-labelledby="riwayatTitle">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5">
        <div>
            <h2 id="riwayatTitle" class="section-title">Riwayat Peminjaman Saya</h2>
            <p class="text-xs text-slate-500 mt-1">
                <%= showAll ? 'Menampilkan seluruh riwayat' : 'Menampilkan transaksi 1 bulan terakhir' %>
            </p>
        </div>
        <div>
            <% if(showAll) { %>
                <a href="/dashboard" class="btn btn-ghost btn-sm">Tampilkan 1 Bulan Terakhir</a>
            <% } else { %>
                <a href="/dashboard?show_all=true" class="btn btn-amber btn-sm">Lihat Semua Riwayat</a>
            <% } %>
        </div>
    </div>

    <div class="tbl-wrap">
        <table class="tbl">
            <thead>
                <tr>
                    <th>Mobil</th>
                    <th>Tujuan</th>
                    <th>Durasi</th>
                    <th>Status</th>
                    <th>Aksi / Opsi</th>
                </tr>
            </thead>
            <tbody>
                <% if (pinjamList.length === 0) { %>
                    <tr><td colspan="5" class="t-empty">Belum ada riwayat peminjaman.</td></tr>
                <% } %>
                <% pinjamList.forEach(p => { %>
                <tr>
                    <td class="whitespace-nowrap"><span class="t-strong"><%= p.merk_tipe %></span><span class="t-sub"><%= p.plat_nomor %></span></td>
                    <td><%= p.tujuan_peminjaman %></td>
                    <td class="whitespace-nowrap"><%= p.lama_pinjam_hari %> Hari</td>
                    <td class="whitespace-nowrap">
                        <% if(p.status_peminjaman === 'APPROVED') { %>
                            <span class="badge badge-free">APPROVED</span>
                        <% } else if(p.status_peminjaman === 'REJECTED') { %>
                            <span class="badge badge-maint">DIBATALKAN</span>
                        <% } else { %>
                            <span class="badge badge-done">RETURNED</span>
                        <% } %>
                    </td>
                    <td class="whitespace-nowrap">
                        <% if(p.status_peminjaman === 'APPROVED') { %>
                        <form action="/dashboard/kembalikan" method="POST" class="flex flex-col sm:flex-row gap-2">
                            <input type="hidden" name="peminjaman_id" value="<%= p.id %>">
                            <input type="hidden" name="mobil_id" value="<%= p.mobil_id %>">
                            <input type="text" name="catatan_kondisi" placeholder="Laporan Kondisi Mobil" aria-label="Laporan kondisi mobil" class="field field-sm field-inline">
                            <button class="btn btn-accent btn-sm">Kembalikan</button>
                        </form>
                        <% } else { %>
                        <span class="text-slate-400">-</span>
                        <% } %>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</section>

<script>
let fpMulai, fpSelesai, fpPegawaiView;
let activeMobilForBooking = { id: '', merk: '', plat: '' };

function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
}

const CAL_ICON = '<svg class="inline-block w-3.5 h-3.5 -mt-0.5 mr-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/></svg>';

function openDetailModal(mobilId, merk, plat) {
    activeMobilForBooking = { id: mobilId, merk: merk, plat: plat };
    document.getElementById('detailMobilTitle').innerText = merk;
    document.getElementById('detailMobilPlat').innerText = plat;

    const container = document.getElementById('jadwalContainer');
    container.innerHTML = '<p class="text-xs text-slate-400">Memuat jadwal...</p>';

    fetch(`/dashboard/mobil/${mobilId}/jadwal`)
        .then(res => res.json())
        .then(data => {
            const disableRanges = [];
            data.forEach(item => {
                disableRanges.push({
                    from: item.tgl_mulai.split('T')[0],
                    to: item.tgl_selesai.split('T')[0]
                });
            });

            if (fpPegawaiView) fpPegawaiView.destroy();
            fpPegawaiView = flatpickr("#pegawaiCalendarView", {
                inline: false,
                dateFormat: "Y-m-d",
                disable: disableRanges,
                onDayCreate: function(dObj, dStr, fp, dayElem) {
                    const dayDate = dayElem.dateObj;
                    disableRanges.forEach(range => {
                        const start = new Date(range.from);
                        const end = new Date(range.to);
                        start.setHours(0,0,0,0);
                        end.setHours(23,59,59,999);
                        if (dayDate >= start && dayDate <= end) {
                            dayElem.classList.add("booked-date");
                            dayElem.title = "Sudah ter-booking";
                        }
                    });
                }
            });

            document.getElementById('pegawaiCalendarBtn').onclick = () => {
                fpPegawaiView.open();
            };

            if (data.length === 0) {
                container.innerHTML = '<div class="sched-empty">Belum ada jadwal booking. Mobil ini sepenuhnya bebas dipinjam!</div>';
                return;
            }
            let html = '';
            data.forEach(item => {
                const tglStart = new Date(item.tgl_mulai).toLocaleDateString('id-ID', { day: '2-digit', month: '2-digit', year: 'numeric' });
                const tglEnd = new Date(item.tgl_selesai).toLocaleDateString('id-ID', { day: '2-digit', month: '2-digit', year: 'numeric' });

                html += `
                    <div class="sched-item">
                        <div class="flex justify-between items-center gap-2">
                            <span class="font-bold text-slate-900 truncate">${esc(item.nama_peminjam)} (${esc(item.nama_seksi || '-')})</span>
                            <span class="badge badge-free shrink-0">APPROVED</span>
                        </div>
                        <p class="text-slate-600 break-words mt-1"><strong>Tujuan:</strong> ${esc(item.tujuan_peminjaman)}</p>
                        <p class="text-brandBlue font-semibold mt-1">${CAL_ICON}${tglStart} s/d ${tglEnd}</p>
                    </div>
                `;
            });
            container.innerHTML = html;
        })
        .catch(err => {
            container.innerHTML = '<p class="text-xs text-rose-600">Gagal memuat jadwal peminjaman.</p>';
        });

    document.body.classList.add('overflow-hidden');
    const modal = document.getElementById('detailModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
}

function closeDetailModal() {
    document.body.classList.remove('overflow-hidden');
    const modal = document.getElementById('detailModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
}

function openBookingModal(mobilId, merk, plat) {
    closeDetailModal();

    document.getElementById('booking_mobil_id').value = mobilId;
    document.getElementById('bookingMobilTitle').innerText = `Booking ${merk}`;
    document.getElementById('bookingMobilPlat').innerText = plat;

    fetch(`/dashboard/mobil/${mobilId}/jadwal`)
        .then(res => res.json())
        .then(data => {
            const disableRanges = [];
            data.forEach(item => {
                disableRanges.push({
                    from: item.tgl_mulai.split('T')[0],
                    to: item.tgl_selesai.split('T')[0]
                });
            });

            if (fpMulai) fpMulai.destroy();
            if (fpSelesai) fpSelesai.destroy();

            const maxDateLimit = new Date();
            maxDateLimit.setDate(maxDateLimit.getDate() + 7);

            const flatpickrConfig = {
                enableTime: true,
                dateFormat: "Y-m-d H:i",
                minDate: "today",
                maxDate: maxDateLimit,
                disable: disableRanges,
                onDayCreate: function(dObj, dStr, fp, dayElem) {
                    const dayDate = dayElem.dateObj;
                    disableRanges.forEach(range => {
                        const start = new Date(range.from);
                        const end = new Date(range.to);
                        start.setHours(0,0,0,0);
                        end.setHours(23,59,59,999);
                        if (dayDate >= start && dayDate <= end) {
                            dayElem.classList.add("booked-date");
                            dayElem.title = "Sudah ter-booking";
                        }
                    });
                }
            };

            fpMulai = flatpickr("#tgl_mulai_picker", flatpickrConfig);
            fpSelesai = flatpickr("#tgl_selesai_picker", flatpickrConfig);
        });

    document.body.classList.add('overflow-hidden');
    const modal = document.getElementById('bookingModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
}

function closeBookingModal() {
    document.body.classList.remove('overflow-hidden');
    const modal = document.getElementById('bookingModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');

    if (activeMobilForBooking.id) {
        openDetailModal(activeMobilForBooking.id, activeMobilForBooking.merk, activeMobilForBooking.plat);
        activeMobilForBooking = { id: '', merk: '', plat: '' };
    }
}
</script>

<%- include('partials/footer') %>