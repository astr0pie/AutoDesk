<%- include('partials/header') %>

<!-- Flatpickr CSS & JS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<style>
  .flatpickr-calendar {
    font-family: inherit !important;
    border-radius: 0.75rem !important;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1) !important;
    border: 1px solid #e2e8f0 !important;
    z-index: 9999 !important;
  }
  .flatpickr-current-month {
    font-family: inherit !important;
    font-weight: 700 !important;
    font-size: 0.95rem !important;
  }
  .flatpickr-current-month .flatpickr-monthDropdown-months,
  .flatpickr-current-month input.cur-year {
    font-family: inherit !important;
    font-weight: 700 !important;
  }
  .flatpickr-day.booked-date {
    background-color: #fef08a !important;
    color: #854d0e !important;
    font-weight: 700 !important;
    border-radius: 9999px !important;
    border: 1px solid #fde047 !important;
    max-width: 28px !important;
    height: 28px !important;
    line-height: 26px !important;
    margin: 2px auto !important;
  }
</style>

<div class="mb-6 sm:mb-8">
    <h1 class="text-xl sm:text-2xl font-bold text-brandBlue">Dashboard Peminjaman Mobil</h1>
    <p class="text-slate-500 text-xs sm:text-sm">Pilih unit kendaraan dinas dan atur jadwal peminjaman Anda.</p>
</div>

<!-- Daftar Mobil -->
<div class="mb-10">
    <h2 class="text-base sm:text-lg font-semibold text-slate-800 mb-4 flex items-center gap-2">
        <span class="w-3 h-3 bg-brandYellow rounded-full inline-block"></span> Status Kendaraan Operasional
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
        <% mobilList.forEach(m => { %>
        <div class="bg-brandCard border border-slate-200 rounded-xl p-4 sm:p-5 shadow-sm hover:shadow-md transition flex flex-col justify-between">
            <div>
                <div class="flex justify-between items-start mb-3 gap-2">
                    <div class="min-w-0 flex-1">
                        <h3 class="font-bold text-base sm:text-lg text-slate-900 truncate"><%= m.merk_tipe %></h3>
                        <p class="text-[11px] sm:text-xs font-mono bg-slate-200 text-slate-700 px-2 py-0.5 rounded inline-block mt-1 break-all"><%= m.plat_nomor %></p>
                    </div>
                    <% if(m.status === 'FREE') { %>
                        <span class="px-2.5 py-1 bg-emerald-100 text-emerald-700 text-[10px] sm:text-xs font-bold rounded-full shrink-0">FREE</span>
                    <% } else if(m.status === 'DIPINJAM') { %>
                        <span class="px-2.5 py-1 bg-amber-100 text-amber-700 text-[10px] sm:text-xs font-bold rounded-full shrink-0">DIPINJAM</span>
                    <% } else { %>
                        <span class="px-2.5 py-1 bg-rose-100 text-rose-700 text-[10px] sm:text-xs font-bold rounded-full shrink-0">MAINTENANCE</span>
                    <% } %>
                </div>
                
                <div class="text-xs sm:text-sm text-slate-600 space-y-1 mb-4">
                    <p>Kategori: <strong><%= m.kategori %></strong> (<%= m.kapasitas %> Seat)</p>
                    <p>Catatan Kondisi: <span class="italic text-slate-500 break-words"><%= m.kondapat_catatan || 'Siap pakai' %></span></p>
                </div>
            </div>

            <div class="pt-3 border-t border-slate-200 space-y-2">
                <button type="button" 
                    onclick="openDetailModal('<%= m.id %>', '<%= m.merk_tipe %>', '<%= m.plat_nomor %>')"
                    class="w-full py-2 bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-bold rounded-lg transition flex items-center justify-center gap-1">
                    📌 Detail Peminjam & Jadwal
                </button>
                <button type="button" 
                    onclick="openBookingModal('<%= m.id %>', '<%= m.merk_tipe %>', '<%= m.plat_nomor %>')"
                    class="w-full py-2 bg-brandBlue hover:bg-blue-800 text-white text-xs font-bold rounded-lg transition flex items-center justify-center gap-1">
                    📅 Ajukan Pinjaman / Booking
                </button>
            </div>
        </div>
        <% }) %>
    </div>
</div>

<!-- MODAL 1: Detail Peminjam & Jadwal Booking -->
<div id="detailModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center z-50 p-3 sm:p-4">
    <div class="bg-white rounded-xl max-w-lg w-full p-4 sm:p-6 shadow-xl border border-slate-200 max-h-[85vh] overflow-y-auto">
        <div class="flex justify-between items-center mb-4 border-b pb-3">
            <div class="min-w-0 pr-2">
                <h3 id="detailMobilTitle" class="text-base sm:text-lg font-bold text-brandBlue truncate"></h3>
                <p id="detailMobilPlat" class="text-xs text-slate-500 font-mono"></p>
            </div>
            <button type="button" onclick="closeDetailModal()" class="text-slate-400 hover:text-slate-600 font-bold text-xl">&times;</button>
        </div>

        <div class="space-y-4">
            <div>
                <h4 class="text-xs font-bold text-slate-700 uppercase mb-2">📌 Daftar Jadwal Ter-booking:</h4>
                <div id="jadwalContainer" class="space-y-2">
                    <p class="text-xs text-slate-400">Memuat data jadwal...</p>
                </div>
            </div>
        </div>

        <div class="mt-6 pt-3 border-t flex justify-end gap-2">
            <button type="button" onclick="closeDetailModal()" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-lg transition">Tutup</button>
        </div>
    </div>
</div>

<!-- MODAL 2: Form Ajukan Pinjaman / Booking -->
<div id="bookingModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center z-50 p-3 sm:p-4">
    <div class="bg-white rounded-xl max-w-md w-full p-4 sm:p-6 shadow-xl border border-slate-200 max-h-[90vh] overflow-y-auto">
        <div class="flex justify-between items-center mb-4 border-b pb-3">
            <div class="min-w-0 pr-2">
                <h3 id="bookingMobilTitle" class="text-base sm:text-lg font-bold text-brandBlue truncate">Form Peminjaman</h3>
                <p id="bookingMobilPlat" class="text-xs text-slate-500 font-mono"></p>
            </div>
            <button type="button" onclick="closeBookingModal()" class="text-slate-400 hover:text-slate-600 font-bold text-xl">&times;</button>
        </div>

        <form action="/dashboard/pinjam" method="POST" class="space-y-3">
            <input type="hidden" id="booking_mobil_id" name="mobil_id">
            
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Tujuan Dinas / Kegiatan</label>
                <input type="text" name="tujuan" required placeholder="Contoh: Pendampingan Pemeriksaan Lapangan" class="w-full p-2 text-xs border border-slate-300 rounded focus:outline-none focus:border-brandBlue">
            </div>

            <div class="p-3 bg-amber-50 border border-amber-200 rounded-lg text-xs text-amber-900">
                <p class="font-bold flex items-center gap-1 mb-1">💡 Catatan Kalender Pemilih Tanggal:</p>
                <p>Tanggal berlatar <strong>kuning</strong> menunjukkan bahwa mobil sudah ter-booking di tanggal tersebut. Silakan pilih rentang tanggal lain yang masih kosong.</p>
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Tanggal & Waktu Mulai</label>
                <input type="text" id="tgl_mulai_picker" name="tgl_mulai" required placeholder="Pilih Tanggal Mulai" class="w-full p-2 text-xs border border-slate-300 rounded bg-white focus:outline-none focus:border-brandBlue cursor-pointer">
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Tanggal & Waktu Selesai</label>
                <input type="text" id="tgl_selesai_picker" name="tgl_selesai" required placeholder="Pilih Tanggal Selesai" class="w-full p-2 text-xs border border-slate-300 rounded bg-white focus:outline-none focus:border-brandBlue cursor-pointer">
            </div>

            <div class="pt-3 flex justify-end gap-2 border-t">
                <button type="button" onclick="closeBookingModal()" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-lg transition">Batal</button>
                <button type="submit" class="px-4 py-2 bg-brandBlue hover:bg-blue-800 text-white font-bold text-xs rounded-lg transition">Kirim Pengajuan</button>
            </div>
        </form>
    </div>
</div>

<!-- Riwayat Peminjaman Pegawai -->
<div class="bg-white border border-slate-200 rounded-xl p-4 sm:p-6 shadow-sm">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4 pb-3 border-b">
        <div>
            <h2 class="text-base sm:text-lg font-semibold text-brandBlue">Riwayat Peminjaman Saya</h2>
            <p class="text-xs text-slate-500">
                <%= showAll ? 'Menampilkan seluruh riwayat' : 'Menampilkan transaksi 1 bulan terakhir' %>
            </p>
        </div>
        <div>
            <% if(showAll) { %>
                <a href="/dashboard" class="inline-block px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded transition">Tampilkan 1 Bulan Terakhir</a>
            <% } else { %>
                <a href="/dashboard?show_all=true" class="inline-block px-3 py-1.5 bg-amber-100 hover:bg-amber-200 text-amber-900 font-bold text-xs rounded transition">Lihat Semua Riwayat</a>
            <% } %>
        </div>
    </div>

    <div class="overflow-x-auto -mx-4 sm:mx-0">
        <div class="inline-block min-w-full align-middle px-4 sm:px-0">
            <table class="min-w-full text-left text-xs sm:text-sm text-slate-600">
                <thead class="bg-slate-100 text-slate-700 uppercase text-[10px] sm:text-xs">
                    <tr>
                        <th class="p-2 sm:p-3">Mobil</th>
                        <th class="p-2 sm:p-3">Tujuan</th>
                        <th class="p-2 sm:p-3">Durasi</th>
                        <th class="p-2 sm:p-3">Status</th>
                        <th class="p-2 sm:p-3">Aksi / Opsi</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-200">
                    <% if (pinjamList.length === 0) { %>
                        <tr><td colspan="5" class="p-4 text-center text-xs text-slate-400">Belum ada riwayat peminjaman.</td></tr>
                    <% } %>
                    <% pinjamList.forEach(p => { %>
                    <tr>
                        <td class="p-2 sm:p-3 font-semibold text-slate-800 whitespace-nowrap"><%= p.merk_tipe %><br><span class="text-[10px] font-mono text-slate-500"><%= p.plat_nomor %></span></td>
                        <td class="p-2 sm:p-3"><%= p.tujuan_peminjaman %></td>
                        <td class="p-2 sm:p-3 whitespace-nowrap"><%= p.lama_pinjam_hari %> Hari</td>
                        <td class="p-2 sm:p-3 whitespace-nowrap">
                            <% if(p.status_peminjaman === 'APPROVED') { %>
                                <span class="px-2 py-0.5 text-[10px] sm:text-xs font-bold rounded bg-emerald-100 text-emerald-700">APPROVED</span>
                            <% } else if(p.status_peminjaman === 'PENDING') { %>
                                <span class="px-2 py-0.5 text-[10px] sm:text-xs font-bold rounded bg-amber-100 text-amber-700">MENUNGGU ADMIN</span>
                            <% } else if(p.status_peminjaman === 'REJECTED') { %>
                                <span class="px-2 py-0.5 text-[10px] sm:text-xs font-bold rounded bg-rose-100 text-rose-700">REJECTED</span>
                            <% } else { %>
                                <span class="px-2 py-0.5 text-[10px] sm:text-xs font-bold rounded bg-slate-100 text-slate-600">RETURNED</span>
                            <% } %>
                        </td>
                        <td class="p-2 sm:p-3 whitespace-nowrap">
                            <% if(p.status_peminjaman === 'APPROVED') { %>
                            <form action="/dashboard/kembalikan" method="POST" class="flex flex-col sm:flex-row gap-1 sm:gap-2">
                                <input type="hidden" name="peminjaman_id" value="<%= p.id %>">
                                <input type="hidden" name="mobil_id" value="<%= p.mobil_id %>">
                                <input type="text" name="catatan_kondisi" placeholder="Laporan Kondisi Mobil" class="text-xs p-1 border rounded w-32 sm:w-40">
                                <button class="px-2 py-1 bg-brandYellow hover:bg-yellow-500 text-slate-900 font-bold text-xs rounded">Kembalikan</button>
                            </form>
                            <% } else { %>
                            -
                            <% } %>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
let fpMulai, fpSelesai;
let activeMobilForBooking = { id: '', merk: '', plat: '' };

function openDetailModal(mobilId, merk, plat) {
    activeMobilForBooking = { id: mobilId, merk: merk, plat: plat };
    document.getElementById('detailMobilTitle').innerText = merk;
    document.getElementById('detailMobilPlat').innerText = plat;
    
    const container = document.getElementById('jadwalContainer');
    container.innerHTML = '<p class="text-xs text-slate-400">Memuat jadwal...</p>';

    fetch(`/dashboard/mobil/${mobilId}/jadwal`)
        .then(res => res.json())
        .then(data => {
            if (data.length === 0) {
                container.innerHTML = '<div class="p-3 bg-emerald-50 text-emerald-800 rounded-lg text-xs">Belum ada jadwal booking. Mobil ini sepenuhnya bebas dipinjam!</div>';
                return;
            }
            let html = '';
            data.forEach(item => {
                const tglStart = new Date(item.tgl_mulai).toLocaleDateString('id-ID', { day: '2-digit', month: '2-digit', year: 'numeric' });
                const tglEnd = new Date(item.tgl_selesai).toLocaleDateString('id-ID', { day: '2-digit', month: '2-digit', year: 'numeric' });
                const badgeColor = item.status_peminjaman === 'APPROVED' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800';

                html += `
                    <div class="p-3 border border-slate-200 bg-slate-50 rounded-lg text-xs space-y-1">
                        <div class="flex justify-between items-center gap-2">
                            <span class="font-bold text-slate-900 truncate">${item.nama_peminjam} (${item.nama_seksi || '-'})</span>
                            <span class="px-2 py-0.5 text-[10px] font-bold rounded-full ${badgeColor} shrink-0">${item.status_peminjaman}</span>
                        </div>
                        <p class="text-slate-600 break-words"><strong>Tujuan:</strong> ${item.tujuan_peminjaman}</p>
                        <p class="text-brandBlue font-semibold">📅 ${tglStart} s/d ${tglEnd}</p>
                    </div>
                `;
            });
            container.innerHTML = html;
        })
        .catch(err => {
            container.innerHTML = '<p class="text-xs text-rose-600">Gagal memuat jadwal peminjaman.</p>';
        });

    document.body.classList.add('overflow-hidden');
    const modal = document.getElementById('detailModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
}

function closeDetailModal() {
    document.body.classList.remove('overflow-hidden');
    const modal = document.getElementById('detailModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
}

function openBookingModal(mobilId, merk, plat) {
    closeDetailModal();

    document.getElementById('booking_mobil_id').value = mobilId;
    document.getElementById('bookingMobilTitle').innerText = `Booking ${merk}`;
    document.getElementById('bookingMobilPlat').innerText = plat;

    fetch(`/dashboard/mobil/${mobilId}/jadwal`)
        .then(res => res.json())
        .then(data => {
            const disableRanges = [];
            data.forEach(item => {
                disableRanges.push({
                    from: item.tgl_mulai.split('T')[0],
                    to: item.tgl_selesai.split('T')[0]
                });
            });

            if (fpMulai) fpMulai.destroy();
            if (fpSelesai) fpSelesai.destroy();

            const flatpickrConfig = {
                enableTime: true,
                dateFormat: "Y-m-d H:i",
                minDate: "today",
                disable: disableRanges,
                onDayCreate: function(dObj, dStr, fp, dayElem) {
                    const dayDate = dayElem.dateObj;
                    disableRanges.forEach(range => {
                        const start = new Date(range.from);
                        const end = new Date(range.to);
                        start.setHours(0,0,0,0);
                        end.setHours(23,59,59,999);
                        if (dayDate >= start && dayDate <= end) {
                            dayElem.classList.add("booked-date");
                            dayElem.title = "Sudah ter-booking";
                        }
                    });
                }
            };

            fpMulai = flatpickr("#tgl_mulai_picker", flatpickrConfig);
            fpSelesai = flatpickr("#tgl_selesai_picker", flatpickrConfig);
        });

    document.body.classList.add('overflow-hidden');
    const modal = document.getElementById('bookingModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
}

function closeBookingModal() {
    document.body.classList.remove('overflow-hidden');
    const modal = document.getElementById('bookingModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');

    if (activeMobilForBooking.id) {
        openDetailModal(activeMobilForBooking.id, activeMobilForBooking.merk, activeMobilForBooking.plat);
        activeMobilForBooking = { id: '', merk: '', plat: '' };
    }
}
</script>

<%- include('partials/footer') %>