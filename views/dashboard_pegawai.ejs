<%- include('partials/header') %>

<!-- Flatpickr (kalender) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/l10n/id.js"></script>

<div class="mb-6 sm:mb-8">
    <h1 class="page-title">Dashboard Peminjaman Mobil</h1>
    <p class="page-sub">Lihat jadwal semua kendaraan dinas dalam satu tabel, lalu klik tanggal yang tersedia untuk membooking. Seksi yang sama tidak dapat meminjam dengan rentang tanggal yang persis sama.</p>
</div>

<!-- Tabel Jadwal (Mobil x 14 Hari) -->
<section id="jadwal" class="card p-4 sm:p-6 mb-8" aria-labelledby="jadwalTitle">
    <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-3 mb-4">
        <div>
            <h2 id="jadwalTitle" class="section-title">Jadwal Pemakaian Kendaraan Dinas Operasional</h2>
            <p class="text-xs text-slate-500 mt-1">Geser tabel ke samping untuk melihat tanggal selanjutnya. Klik kotak hijau (+) untuk membooking mobil.</p>
        </div>
        <div class="week-nav">
            <a class="btn btn-ghost btn-sm" href="/dashboard?start=<%= matrix.prevIso %>#jadwal"><svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg> 14 Hari Sebelumnya</a>
            <span class="week-label"><%= matrix.rangeLabel %></span>
            <a class="btn <%= matrix.isCurrentWeek ? 'btn-soft' : 'btn-ghost' %> btn-sm" href="/dashboard#jadwal">Hari Ini</a>
            <a class="btn btn-ghost btn-sm" href="/dashboard?start=<%= matrix.nextIso %>#jadwal">14 Hari Berikutnya <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg></a>
        </div>
    </div>

    <div class="legend">
        <span><i class="lg-free"></i>Tersedia (klik untuk booking)</span>
        <span><i class="lg-booked"></i>Ter-booking</span>
        <span><i class="lg-own"></i>Booking saya</span>
        <span><i class="lg-maint"></i>Maintenance</span>
    </div>

    <div class="mx-wrap" tabindex="0" role="region" aria-label="Tabel jadwal pemakaian kendaraan">
        <table class="mx">
            <colgroup>
                <col class="mx-col-unit">
                <% matrix.days.forEach(() => { %><col class="mx-col-day"><% }) %>
            </colgroup>
            <thead>
                <tr>
                    <th scope="col" class="mx-unit">Unit Kendaraan</th>
                    <% matrix.days.forEach(d => { %>
                    <th scope="col" class="<%= d.isToday ? 'is-today' : '' %> <%= d.isWeekend ? 'is-weekend' : '' %>"><%= d.label %><small><%= d.dow %></small></th>
                    <% }) %>
                </tr>
            </thead>
            <tbody>
                <% if (matrix.rows.length === 0) { %>
                    <tr><td colspan="<%= matrix.days.length + 1 %>" class="t-empty" style="padding:2rem 1rem;text-align:center;color:var(--faint);">Belum ada unit kendaraan yang terdaftar.</td></tr>
                <% } %>
                <% matrix.rows.forEach(r => { const m = r.mobil; %>
                <tr>
                    <th scope="row" class="mx-unit">
                        <div class="unit-top">
                            <span class="plate plate-sm"><%= m.plat_nomor %></span>
                            <% if (m.status === 'MAINTENANCE') { %>
                                <span class="badge badge-maint">MAINTENANCE</span>
                            <% } else if (m.is_booked || m.status === 'DIPINJAM') { %>
                                <span class="badge badge-busy">Booked</span>
                            <% } else { %>
                                <span class="badge badge-free">FREE</span>
                            <% } %>
                        </div>
                        <button type="button" class="unit-name" data-id="<%= m.id %>" data-merk="<%= m.merk_tipe %>" data-plat="<%= m.plat_nomor %>" data-status="<%= m.status %>" onclick="openJadwalModal(this)"><%= m.merk_tipe %></button>
                        <span class="unit-meta"><%= m.kategori %> &middot; <%= m.kapasitas %> Seat</span>
                        <span class="unit-note" title="<%= m.kondapat_catatan || 'Siap pakai' %>">Kondisi: <%= m.kondapat_catatan || 'Siap pakai' %></span>
                    </th>
                    <% r.cells.forEach(c => { %>
                        <% if (c.type === 'maint') { %>
                            <td colspan="<%= c.span %>" class="day"><div class="cell cell-maint"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/></svg> Maintenance - unit terkunci sampai admin mengubah status menjadi FREE</div></td>
                        <% } else if (c.type === 'booked') { %>
                            <td colspan="<%= c.span %>" class="day">
                                <button type="button" class="cell cell-booked <%= c.own ? 'is-own' : '' %> <%= c.clipL ? 'clip-l' : '' %> <%= c.clipR ? 'clip-r' : '' %>"
                                    title="<%= c.nama %> (<%= c.seksi || '-' %>) | <%= c.tujuan %> | <%= c.mulai %> s/d <%= c.selesai %>"
                                    data-id="<%= m.id %>" data-merk="<%= m.merk_tipe %>" data-plat="<%= m.plat_nomor %>" data-status="<%= m.status %>"
                                    onclick="openJadwalModal(this)">
                                    <span class="cell-name"><%= c.own ? 'Saya - ' : '' %><%= c.nama %></span>
                                    <span class="cell-sub"><%= c.seksi || '-' %></span>
                                </button>
                            </td>
                        <% } else if (c.type === 'free') { %>
                            <td class="day"><button type="button" class="cell cell-free" title="Booking <%= m.merk_tipe %> pada <%= c.iso %>" aria-label="Booking <%= m.merk_tipe %> pada <%= c.iso %>" data-id="<%= m.id %>" data-merk="<%= m.merk_tipe %>" data-plat="<%= m.plat_nomor %>" data-status="<%= m.status %>" data-date="<%= c.iso %>" onclick="openBookingFromCell(this)"><svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg></button></td>
                        <% } else { %>
                            <td class="day"><div class="cell cell-off" aria-hidden="true" title="<%= c.type === 'far' ? 'Tanggal mulai booking maksimal 7 hari dari hari ini' : 'Tanggal sudah lewat' %>">&ndash;</div></td>
                        <% } %>
                    <% }) %>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</section>

<!-- Modal Jadwal Unit (kalender + daftar peminjam) -->
<div id="jadwalModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center z-50 p-2 sm:p-4">
    <div class="modal-panel max-w-md max-h-[92vh] overflow-y-auto" role="dialog" aria-modal="true" aria-labelledby="jadwalMobilTitle">
        <div class="modal-head">
            <div class="min-w-0">
                <h3 id="jadwalMobilTitle" class="modal-title"></h3>
                <p id="jadwalMobilPlat" class="plate plate-sm mt-1"></p>
            </div>
            <button type="button" onclick="closeJadwalModal()" class="icon-btn" aria-label="Tutup"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg></button>
        </div>

        <div class="cal-box fp-readonly"><input type="text" id="jadwalCalendar" class="hidden" tabindex="-1" aria-hidden="true"></div>
        <p class="hint text-center">Tanggal berlatar <strong>kuning</strong> sudah ter-booking.</p>

        <div class="mt-4">
            <h4 class="label mb-2">Daftar Rincian Peminjam</h4>
            <div id="jadwalList"><p class="text-xs text-slate-400">Memuat data jadwal...</p></div>
        </div>

        <div class="modal-foot">
            <button type="button" onclick="closeJadwalModal()" class="btn btn-ghost">Tutup</button>
            <button type="button" id="btnBookFromJadwal" onclick="bookFromJadwal()" class="btn btn-primary">Booking Mobil Ini</button>
        </div>
    </div>
</div>

<!-- Modal Form Booking (kalender rentang tanggal) -->
<div id="bookingModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center z-50 p-2 sm:p-4">
    <div class="modal-panel max-w-md max-h-[94vh] overflow-y-auto" role="dialog" aria-modal="true" aria-labelledby="bookingMobilTitle">
        <div class="modal-head">
            <div class="min-w-0">
                <h3 id="bookingMobilTitle" class="modal-title">Form Peminjaman</h3>
                <p id="bookingMobilPlat" class="plate plate-sm mt-1"></p>
            </div>
            <button type="button" onclick="closeBookingModal()" class="icon-btn" aria-label="Tutup"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg></button>
        </div>

        <form action="/dashboard/pinjam" method="POST" onsubmit="return validateBooking()" autocomplete="off">
            <input type="hidden" id="booking_mobil_id" name="mobil_id">
            <input type="hidden" id="tgl_mulai_val" name="tgl_mulai">
            <input type="hidden" id="tgl_selesai_val" name="tgl_selesai">

            <div>
                <label for="tujuanInput" class="label">Tujuan Dinas / Kegiatan</label>
                <input type="text" id="tujuanInput" name="tujuan" required autocomplete="off" placeholder="Contoh: Pendampingan Pemeriksaan Lapangan" class="field">
            </div>

            <div class="mt-4">
                <span class="label">Pilih Tanggal Peminjaman</span>
                <div class="cal-box"><input type="text" id="bookingRange" class="hidden" tabindex="-1" aria-hidden="true"></div>
                <div id="rangeSummary" class="range-summary" aria-live="polite"></div>
                <p class="hint">Tanggal mulai maksimal 7 hari ke depan (sampai <%= matrix.maxStartLabel %>), tanggal selesai bebas. Berlatar <strong>kuning</strong> = sudah ter-booking. Seksi yang sama tidak boleh meminjam dengan rentang tanggal yang persis sama.</p>
            </div>

            <div id="bookingError" class="alert alert-error mt-3" role="alert" style="display:none;"></div>

            <div class="modal-foot">
                <button type="button" onclick="closeBookingModal()" class="btn btn-ghost">Batal</button>
                <button type="submit" class="btn btn-primary">Kirim Pengajuan</button>
            </div>
        </form>
    </div>
</div>

<!-- Riwayat Peminjaman Pegawai -->
<section class="card p-4 sm:p-6" aria-labelledby="riwayatTitle">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5">
        <div>
            <h2 id="riwayatTitle" class="section-title">Riwayat Peminjaman Saya</h2>
            <p class="text-xs text-slate-500 mt-1">
                <%= showAll ? 'Menampilkan seluruh riwayat' : 'Menampilkan transaksi 1 bulan terakhir' %>
            </p>
        </div>
        <div>
            <% if(showAll) { %>
                <a href="/dashboard" class="btn btn-ghost btn-sm">Tampilkan 1 Bulan Terakhir</a>
            <% } else { %>
                <a href="/dashboard?show_all=true" class="btn btn-amber btn-sm">Lihat Semua Riwayat</a>
            <% } %>
        </div>
    </div>

    <div class="tbl-wrap">
        <table class="tbl">
            <thead>
                <tr>
                    <th>Mobil</th>
                    <th>Tujuan</th>
                    <th>Durasi</th>
                    <th>Status</th>
                    <th>Aksi / Opsi</th>
                </tr>
            </thead>
            <tbody>
                <% if (pinjamList.length === 0) { %>
                    <tr><td colspan="5" class="t-empty">Belum ada riwayat peminjaman.</td></tr>
                <% } %>
                <% pinjamList.forEach(p => { %>
                <tr>
                    <td class="whitespace-nowrap"><span class="t-strong"><%= p.merk_tipe %></span><span class="t-sub"><%= p.plat_nomor %></span></td>
                    <td><%= p.tujuan_peminjaman %></td>
                    <td class="whitespace-nowrap"><span class="t-strong"><%= p.lama_pinjam_hari %> Hari</span><span class="t-sub"><%= p.tgl_mulai_fmt %> - <%= p.tgl_selesai_fmt %></span></td>
                    <td class="whitespace-nowrap">
                        <% if(p.status_peminjaman === 'APPROVED') { %>
                            <span class="badge badge-free">APPROVED</span>
                        <% } else if(p.status_peminjaman === 'REJECTED') { %>
                            <span class="badge badge-maint">DIBATALKAN</span>
                        <% } else { %>
                            <span class="badge badge-done">RETURNED</span>
                        <% } %>
                    </td>
                    <td class="whitespace-nowrap">
                        <% if(p.status_peminjaman === 'APPROVED') { %>
                        <form action="/dashboard/kembalikan" method="POST" class="flex flex-col sm:flex-row gap-2">
                            <input type="hidden" name="peminjaman_id" value="<%= p.id %>">
                            <input type="hidden" name="mobil_id" value="<%= p.mobil_id %>">
                            <input type="text" name="catatan_kondisi" placeholder="Laporan Kondisi Mobil" aria-label="Laporan kondisi mobil" class="field field-sm field-inline">
                            <button class="btn btn-accent btn-sm">Kembalikan</button>
                        </form>
                        <% } else { %>
                        <span class="text-slate-400">-</span>
                        <% } %>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</section>

<script>
// ---------- Utilitas ----------
function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
}
const CAL_ICON = '<svg class="inline-block w-3.5 h-3.5 -mt-0.5 mr-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/></svg>';
const LOCALE_ID = (window.flatpickr && flatpickr.l10ns && flatpickr.l10ns.id) ? flatpickr.l10ns.id : 'default';

function pad2(n) { return String(n).padStart(2, '0'); }
function dayIso(d) { return d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate()); }
function inRanges(iso, ranges) { return ranges.some(function (r) { return iso >= r.from && iso <= r.to; }); }
function toRange(item) { return { from: item.tgl_mulai.split('T')[0], to: item.tgl_selesai.split('T')[0] }; }
function fmtLong(d) { return d.toLocaleDateString('id-ID', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' }); }

function openModal(id) {
    document.body.classList.add('overflow-hidden');
    const m = document.getElementById(id);
    m.classList.remove('hidden');
    m.classList.add('flex');
}
function closeModal(id) {
    document.body.classList.remove('overflow-hidden');
    const m = document.getElementById(id);
    m.classList.add('hidden');
    m.classList.remove('flex');
}

// ---------- Modal Jadwal Unit (kalender baca-saja + daftar peminjam) ----------
let fpView = null;

function renderJadwalList(data) {
    const container = document.getElementById('jadwalList');
    if (data.length === 0) {
        container.innerHTML = '<div class="sched-empty">Belum ada jadwal booking. Mobil ini bebas dipinjam.</div>';
        return;
    }
    let html = '';
    data.forEach(function (item) {
        const tglStart = item.tgl_mulai_str || item.tgl_mulai.split('T')[0];
        const tglEnd = item.tgl_selesai_str || item.tgl_selesai.split('T')[0];
        html += '<div class="sched-item">' +
            '<div class="flex justify-between items-center gap-2">' +
                '<span class="font-bold text-slate-900 truncate">' + esc(item.nama_peminjam) + ' (' + esc(item.nama_seksi || '-') + ')</span>' +
                '<span class="badge badge-free shrink-0">APPROVED</span>' +
            '</div>' +
            '<p class="text-slate-600 break-words mt-1"><strong>Tujuan:</strong> ' + esc(item.tujuan_peminjaman) + '</p>' +
            '<p class="text-brandBlue font-semibold mt-1">' + CAL_ICON + tglStart + ' s/d ' + tglEnd + '</p>' +
        '</div>';
    });
    container.innerHTML = html;
}

function closeJadwalModal() {
    closeModal('jadwalModal');
}

let currentMobil = { id: '', merk: '', plat: '', status: '' };

function openJadwalModal(el) {
    currentMobil = { id: el.dataset.id, merk: el.dataset.merk, plat: el.dataset.plat, status: el.dataset.status };
    document.getElementById('jadwalMobilTitle').innerText = currentMobil.merk;
    document.getElementById('jadwalMobilPlat').innerText = currentMobil.plat;
    document.getElementById('btnBookFromJadwal').style.display = currentMobil.status === 'MAINTENANCE' ? 'none' : '';
    document.getElementById('jadwalList').innerHTML = '<p class="text-xs text-slate-400">Memuat data jadwal...</p>';
    openModal('jadwalModal');

    fetch('/dashboard/mobil/' + encodeURIComponent(currentMobil.id) + '/jadwal')
        .then(function (res) { return res.json(); })
        .then(function (data) {
            if (!Array.isArray(data)) throw new Error('format');
            const ranges = data.map(toRange);
            if (fpView) { fpView.destroy(); fpView = null; }
            fpView = flatpickr('#jadwalCalendar', {
                inline: true,
                locale: LOCALE_ID,
                onDayCreate: function (dObj, dStr, fp, dayElem) {
                    if (inRanges(dayIso(dayElem.dateObj), ranges)) {
                        dayElem.classList.add('booked-date');
                        dayElem.title = 'Sudah ter-booking';
                    }
                }
            });
            renderJadwalList(data);
        })
        .catch(function () {
            document.getElementById('jadwalList').innerHTML = '<p class="text-xs text-rose-600">Gagal memuat jadwal peminjaman.</p>';
        });
}

function bookFromJadwal() {
    openBookingModal(currentMobil, null);
}

function openBookingFromCell(el) {
    currentMobil = { id: el.dataset.id, merk: el.dataset.merk, plat: el.dataset.plat, status: el.dataset.status };
    openBookingModal(currentMobil, el.dataset.date);
}

// ---------- Modal Booking (kalender rentang tanggal) ----------
const MAX_START = '<%= matrix.maxStartIso %>';
const MAX_START_LABEL = '<%= matrix.maxStartLabel %>';
let fpBooking = null;
let blocked = { car: [], seksi: [] };
const SEKSI_MSG = 'Seksi Anda sudah memiliki peminjaman dengan tanggal yang sama persis. Pilih tanggal yang berbeda (rentang yang hanya beririsan masih diperbolehkan).';

function isSeksiSamaPersis(s, e) {
    return blocked.seksi.some(function (r) { return r.from === s && r.to === e; });
}

function showBookingError(msg) {
    const box = document.getElementById('bookingError');
    box.innerText = msg;
    box.style.display = 'block';
}
function hideBookingError() {
    document.getElementById('bookingError').style.display = 'none';
}

function updateSummary(selectedDates) {
    const s = document.getElementById('tgl_mulai_val');
    const e = document.getElementById('tgl_selesai_val');
    const box = document.getElementById('rangeSummary');
    hideBookingError();

    if (!selectedDates || selectedDates.length === 0) {
        s.value = ''; e.value = '';
        box.innerHTML = 'Pilih <strong>tanggal mulai</strong>, lalu <strong>tanggal selesai</strong> pada kalender.';
        return;
    }
    const a = selectedDates[0];
    s.value = dayIso(a);

    if (selectedDates.length < 2) {
        e.value = '';
        box.innerHTML = 'Mulai <strong>' + fmtLong(a) + '</strong>. Sekarang klik <strong>tanggal selesai</strong> (klik tanggal yang sama untuk 1 hari).';
    } else {
        const b = selectedDates[1];
        e.value = dayIso(b);
        const n = Math.round((b - a) / 86400000) + 1;
        box.innerHTML = '<strong>' + fmtLong(a) + '</strong> s/d <strong>' + fmtLong(b) + '</strong> &middot; ' + n + ' hari';
    }

    if (s.value > MAX_START) {
        showBookingError('Tanggal mulai maksimal 7 hari dari hari ini (sampai ' + MAX_START_LABEL + '). Pilih tanggal mulai yang lebih awal.');
    } else if (e.value && isSeksiSamaPersis(s.value, e.value)) {
        showBookingError(SEKSI_MSG);
    }
}

function openBookingModal(mobil, presetDate) {
    closeJadwalModal();

    document.getElementById('booking_mobil_id').value = mobil.id;
    document.getElementById('bookingMobilTitle').innerText = 'Booking ' + mobil.merk;
    document.getElementById('bookingMobilPlat').innerText = mobil.plat;
    document.getElementById('tujuanInput').value = '';
    document.getElementById('tgl_mulai_val').value = '';
    document.getElementById('tgl_selesai_val').value = '';
    document.getElementById('rangeSummary').innerHTML = 'Memuat kalender...';
    hideBookingError();
    openModal('bookingModal');

    Promise.all([
        fetch('/dashboard/mobil/' + encodeURIComponent(mobil.id) + '/jadwal').then(function (r) { return r.json(); }),
        fetch('/dashboard/seksi/jadwal').then(function (r) { return r.json(); })
    ]).then(function (res) {
        const car = Array.isArray(res[0]) ? res[0] : [];
        const seksi = Array.isArray(res[1]) ? res[1] : [];
        blocked.car = car.map(toRange);
        blocked.seksi = seksi.map(function (it) { return { from: it.d_mulai, to: it.d_selesai }; });

        if (fpBooking) { fpBooking.destroy(); fpBooking = null; }
        fpBooking = flatpickr('#bookingRange', {
            inline: true,
            mode: 'range',
            dateFormat: 'Y-m-d',
            locale: LOCALE_ID,
            minDate: 'today',
            disable: blocked.car,
            defaultDate: presetDate ? [presetDate, presetDate] : null,
            onDayCreate: function (dObj, dStr, fp, dayElem) {
                const iso = dayIso(dayElem.dateObj);
                if (inRanges(iso, blocked.car)) {
                    dayElem.classList.add('booked-date');
                    dayElem.title = 'Sudah ter-booking';
                }
            },
            onChange: function (selectedDates) { updateSummary(selectedDates); },
            onReady: function (selectedDates) { updateSummary(selectedDates); }
        });
    }).catch(function () {
        document.getElementById('rangeSummary').innerHTML = 'Gagal memuat kalender. Muat ulang halaman lalu coba lagi.';
    });
}

function closeBookingModal() {
    closeModal('bookingModal');
}

function validateBooking() {
    const s = document.getElementById('tgl_mulai_val').value;
    const e = document.getElementById('tgl_selesai_val').value;
    hideBookingError();

    if (!s || !e) {
        showBookingError('Pilih tanggal mulai dan tanggal selesai pada kalender.');
        return false;
    }
    if (s > MAX_START) {
        showBookingError('Tanggal mulai maksimal 7 hari dari hari ini (sampai ' + MAX_START_LABEL + ').');
        return false;
    }
    if (blocked.car.some(function (r) { return s <= r.to && e >= r.from; })) {
        showBookingError('Rentang tanggal yang dipilih melewati hari yang sudah ter-booking. Pilih rentang lain.');
        return false;
    }
    if (isSeksiSamaPersis(s, e)) {
        showBookingError(SEKSI_MSG);
        return false;
    }
    return true;
}
</script>

