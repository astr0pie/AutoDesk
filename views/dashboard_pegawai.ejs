<%- include('partials/header') %>

<!-- Flatpickr (Kalender Interaktif) CSS & JS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<style>
  /* Kustomisasi Kalender Tanggal Ter-booking (Highlight Kuning) */
  .flatpickr-day.booked-date {
    background-color: #fef08a !important;
    color: #854d0e !important;
    font-weight: bold;
    border-radius: 50%;
  }
</style>

<div class="mb-8">
    <h1 class="text-2xl font-bold text-brandBlue">Dashboard Peminjaman Mobil</h1>
    <p class="text-slate-500 text-sm">Pilih unit kendaraan dinas dan atur jadwal peminjaman Anda.</p>
</div>

<!-- Daftar Mobil -->
<div class="mb-10">
    <h2 class="text-lg font-semibold text-slate-800 mb-4 flex items-center gap-2">
        <span class="w-3 h-3 bg-brandYellow rounded-full inline-block"></span> Status Kendaraan Operasional
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <% mobilList.forEach(m => { %>
        <div class="bg-brandCard border border-slate-200 rounded-xl p-5 shadow-sm hover:shadow-md transition flex flex-col justify-between">
            <div>
                <!-- Status Badge Header Card -->
                <div class="flex justify-between items-start mb-3">
                    <div>
                        <h3 class="font-bold text-lg text-slate-900"><%= m.merk_tipe %></h3>
                        <p class="text-xs font-mono bg-slate-200 text-slate-700 px-2 py-0.5 rounded inline-block mt-1"><%= m.plat_nomor %></p>
                    </div>
                    <% if(m.status === 'FREE') { %>
                        <span class="px-2.5 py-1 bg-emerald-100 text-emerald-700 text-xs font-bold rounded-full">FREE</span>
                    <% } else if(m.status === 'DIPINJAM') { %>
                        <span class="px-2.5 py-1 bg-amber-100 text-amber-700 text-xs font-bold rounded-full">DIPINJAM</span>
                    <% } else { %>
                        <span class="px-2.5 py-1 bg-rose-100 text-rose-700 text-xs font-bold rounded-full">MAINTENANCE</span>
                    <% } %>
                </div>
                
                <div class="text-sm text-slate-600 space-y-1 mb-4">
                    <p>Kategori: <strong><%= m.kategori %></strong> (<%= m.kapasitas %> Seat)</p>
                    <p>Catatan Kondisi: <span class="italic text-slate-500"><%= m.kondapat_catatan || 'Siap pakai' %></span></p>
                </div>
            </div>

            <!-- 2 Tombol Utama di Bawah Card Mobil -->
            <div class="pt-3 border-t border-slate-200 space-y-2">
                <button type="button" 
                    onclick="openDetailModal('<%= m.id %>', '<%= m.merk_tipe %>', '<%= m.plat_nomor %>')"
                    class="w-full py-2 bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-bold rounded-lg transition flex items-center justify-center gap-1">
                    📌 Detail Peminjam & Jadwal
                </button>
                <button type="button" 
                    onclick="openBookingModal('<%= m.id %>', '<%= m.merk_tipe %>', '<%= m.plat_nomor %>')"
                    class="w-full py-2 bg-brandBlue hover:bg-blue-800 text-white text-xs font-bold rounded-lg transition flex items-center justify-center gap-1">
                    📅 Ajukan Pinjaman / Booking
                </button>
            </div>
        </div>
        <% }) %>
    </div>
</div>

<!-- MODAL 1: Detail Peminjam & Jadwal Booking -->
<div id="detailModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
    <div class="bg-white rounded-xl max-w-lg w-full p-6 shadow-xl border border-slate-200 max-h-[90vh] overflow-y-auto">
        <div class="flex justify-between items-center mb-4 border-b pb-3">
            <div>
                <h3 id="detailMobilTitle" class="text-lg font-bold text-brandBlue"></h3>
                <p id="detailMobilPlat" class="text-xs text-slate-500 font-mono"></p>
            </div>
            <button type="button" onclick="closeDetailModal()" class="text-slate-400 hover:text-slate-600 font-bold text-lg">&times;</button>
        </div>

        <div class="space-y-4">
            <div>
                <h4 class="text-xs font-bold text-slate-700 uppercase mb-2">📌 Daftar Jadwal Ter-booking:</h4>
                <div id="jadwalContainer" class="space-y-2">
                    <p class="text-xs text-slate-400">Memuat data jadwal...</p>
                </div>
            </div>
        </div>

        <div class="mt-6 pt-3 border-t flex justify-end">
            <button type="button" onclick="closeDetailModal()" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-lg transition">Tutup</button>
        </div>
    </div>
</div>

<!-- MODAL 2: Form Ajukan Pinjaman / Booking -->
<div id="bookingModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center z-50 p-4">
    <div class="bg-white rounded-xl max-w-md w-full p-6 shadow-xl border border-slate-200">
        <div class="flex justify-between items-center mb-4 border-b pb-3">
            <div>
                <h3 id="bookingMobilTitle" class="text-lg font-bold text-brandBlue">Form Peminjaman</h3>
                <p id="bookingMobilPlat" class="text-xs text-slate-500 font-mono"></p>
            </div>
            <button type="button" onclick="closeBookingModal()" class="text-slate-400 hover:text-slate-600 font-bold text-lg">&times;</button>
        </div>

        <form action="/dashboard/pinjam" method="POST" class="space-y-3">
            <input type="hidden" id="booking_mobil_id" name="mobil_id">
            
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Tujuan Dinas / Kegiatan</label>
                <input type="text" name="tujuan" required placeholder="Contoh: Pendampingan Pemeriksaan Lapangan" class="w-full p-2 text-xs border border-slate-300 rounded focus:outline-none focus:border-brandBlue">
            </div>

            <div class="p-3 bg-amber-50 border border-amber-200 rounded-lg text-xs text-amber-900">
                <p class="font-bold flex items-center gap-1 mb-1">💡 Catatan Kalender Pemilih Tanggal:</p>
                <p>Tanggal berlatar **kuning** menunjukkan bahwa mobil sudah ter-booking di tanggal tersebut. Silakan pilih rentang tanggal lain yang masih kosong.</p>
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Tanggal & Waktu Mulai</label>
                <input type="text" id="tgl_mulai_picker" name="tgl_mulai" required placeholder="Pilih Tanggal Mulai" class="w-full p-2 text-xs border border-slate-300 rounded bg-white focus:outline-none focus:border-brandBlue">
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Tanggal & Waktu Selesai</label>
                <input type="text" id="tgl_selesai_picker" name="tgl_selesai" required placeholder="Pilih Tanggal Selesai" class="w-full p-2 text-xs border border-slate-300 rounded bg-white focus:outline-none focus:border-brandBlue">
            </div>

            <div class="pt-3 flex justify-end gap-2 border-t">
                <button type="button" onclick="closeBookingModal()" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-lg transition">Batal</button>
                <button type="submit" class="px-4 py-2 bg-brandBlue hover:bg-blue-800 text-white font-bold text-xs rounded-lg transition">Kirim Pengajuan</button>
            </div>
        </form>
    </div>
</div>

<!-- Riwayat Peminjaman Pegawai -->
<div class="bg-white border border-slate-200 rounded-xl p-6 shadow-sm">
    <h2 class="text-lg font-semibold text-brandBlue mb-4">Riwayat Peminjaman Saya</h2>
    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm text-slate-600">
            <thead class="bg-slate-100 text-slate-700 uppercase text-xs">
                <tr>
                    <th class="p-3">Mobil</th>
                    <th class="p-3">Tujuan</th>
                    <th class="p-3">Durasi</th>
                    <th class="p-3">Status</th>
                    <th class="p-3">Aksi / Opsi</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
                <% if (pinjamList.length === 0) { %>
                    <tr><td colspan="5" class="p-4 text-center text-xs text-slate-400">Belum ada riwayat peminjaman.</td></tr>
                <% } %>
                <% pinjamList.forEach(p => { %>
                <tr>
                    <td class="p-3 font-semibold text-slate-800"><%= p.merk_tipe %> (<%= p.plat_nomor %>)</td>
                    <td class="p-3"><%= p.tujuan_peminjaman %></td>
                    <td class="p-3"><%= p.lama_pinjam_hari %> Hari</td>
                    <td class="p-3">
                        <% if(p.status_peminjaman === 'APPROVED') { %>
                            <span class="px-2 py-1 text-xs font-bold rounded bg-emerald-100 text-emerald-700">APPROVED</span>
                        <% } else if(p.status_peminjaman === 'PENDING') { %>
                            <span class="px-2 py-1 text-xs font-bold rounded bg-amber-100 text-amber-700">MENUNGGU ADMIN</span>
                        <% } else if(p.status_peminjaman === 'REJECTED') { %>
                            <span class="px-2 py-1 text-xs font-bold rounded bg-rose-100 text-rose-700">REJECTED</span>
                        <% } else { %>
                            <span class="px-2 py-1 text-xs font-bold rounded bg-slate-100 text-slate-600">RETURNED</span>
                        <% } %>
                    </td>
                    <td class="p-3">
                        <% if(p.status_peminjaman === 'APPROVED') { %>
                        <form action="/dashboard/kembalikan" method="POST" class="flex gap-2">
                            <input type="hidden" name="peminjaman_id" value="<%= p.id %>">
                            <input type="hidden" name="mobil_id" value="<%= p.mobil_id %>">
                            <input type="text" name="catatan_kondisi" placeholder="Laporan Kondisi Mobil" class="text-xs p-1 border rounded w-40">
                            <button class="px-2 py-1 bg-brandYellow hover:bg-yellow-500 text-slate-900 font-bold text-xs rounded">Kembalikan</button>
                        </form>
                        <% } else { %>
                        -
                        <% } %>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<script>
let fpMulai, fpSelesai;

function openDetailModal(mobilId, merk, plat) {
    document.getElementById('detailMobilTitle').innerText = merk;
    document.getElementById('detailMobilPlat').innerText = plat;
    
    const container = document.getElementById('jadwalContainer');
    container.innerHTML = '<p class="text-xs text-slate-400">Memuat jadwal...</p>';

    fetch(`/dashboard/mobil/${mobilId}/jadwal`)
        .then(res => res.json())
        .then(data => {
            if (data.length === 0) {
                container.innerHTML = '<div class="p-3 bg-emerald-50 text-emerald-800 rounded-lg text-xs">Belum ada jadwal booking. Mobil ini sepenuhnya bebas dipinjam!</div>';
                return;
            }
            let html = '';
            data.forEach(item => {
                const tglStart = new Date(item.tgl_mulai).toLocaleDateString('id-ID', { day: '2-digit', month: '2-digit', year: 'numeric' });
                const tglEnd = new Date(item.tgl_selesai).toLocaleDateString('id-ID', { day: '2-digit', month: '2-digit', year: 'numeric' });
                const badgeColor = item.status_peminjaman === 'APPROVED' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800';

                html += `
                    <div class="p-3 border border-slate-200 bg-slate-50 rounded-lg text-xs space-y-1">
                        <div class="flex justify-between items-center">
                            <span class="font-bold text-slate-900">${item.nama_peminjam} (${item.nama_seksi || '-'})</span>
                            <span class="px-2 py-0.5 text-[10px] font-bold rounded-full ${badgeColor}">${item.status_peminjaman}</span>
                        </div>
                        <p class="text-slate-600"><strong>Tujuan:</strong> ${item.tujuan_peminjaman}</p>
                        <p class="text-brandBlue font-semibold">📅 ${tglStart} s/d ${tglEnd}</p>
                    </div>
                `;
            });
            container.innerHTML = html;
        })
        .catch(err => {
            container.innerHTML = '<p class="text-xs text-rose-600">Gagal memuat jadwal peminjaman.</p>';
        });

    const modal = document.getElementById('detailModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
}

function closeDetailModal() {
    const modal = document.getElementById('detailModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
}

function openBookingModal(mobilId, merk, plat) {
    document.getElementById('booking_mobil_id').value = mobilId;
    document.getElementById('bookingMobilTitle').innerText = `Booking ${merk}`;
    document.getElementById('bookingMobilPlat').innerText = plat;

    // Fetch jadwal ter-booking untuk dikonfigurasi ke Flatpickr
    fetch(`/dashboard/mobil/${mobilId}/jadwal`)
        .then(res => res.json())
        .then(data => {
            const disableRanges = [];
            data.forEach(item => {
                disableRanges.push({
                    from: item.tgl_mulai.split('T')[0],
                    to: item.tgl_selesai.split('T')[0]
                });
            });

            if (fpMulai) fpMulai.destroy();
            if (fpSelesai) fpSelesai.destroy();

            const flatpickrConfig = {
                enableTime: true,
                dateFormat: "Y-m-d H:i",
                minDate: "today",
                disable: disableRanges,
                onDayCreate: function(dObj, dStr, fp, dayElem) {
                    const dayDate = dayElem.dateObj;
                    disableRanges.forEach(range => {
                        const start = new Date(range.from);
                        const end = new Date(range.to);
                        start.setHours(0,0,0,0);
                        end.setHours(23,59,59,999);
                        if (dayDate >= start && dayDate <= end) {
                            dayElem.classList.add("booked-date");
                            dayElem.title = "Sudah ter-booking";
                        }
                    });
                }
            };

            fpMulai = flatpickr("#tgl_mulai_picker", flatpickrConfig);
            fpSelesai = flatpickr("#tgl_selesai_picker", flatpickrConfig);
        });

    const modal = document.getElementById('bookingModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
}

function closeBookingModal() {
    const modal = document.getElementById('bookingModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
}
</script>

<%- include('partials/footer') %>