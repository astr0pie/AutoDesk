<%- include('partials/header') %>

<!-- Flatpickr (kalender) -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/l10n/id.js"></script>

<div class="mb-6 sm:mb-8">
    <h1 class="page-title">Panel Kontrol Administrator</h1>
    <p class="page-sub">Pantau jadwal seluruh kendaraan dinas, kelola armada, dan batalkan peminjaman jika diperlukan.</p>
</div>

<!-- Tabel Jadwal Mingguan (Mobil x 7 Hari) -->
<section id="jadwal" class="card p-4 sm:p-6 mb-8" aria-labelledby="jadwalTitle">
    <div class="flex flex-col xl:flex-row xl:items-center justify-between gap-3 mb-4">
        <div>
            <h2 id="jadwalTitle" class="section-title">Jadwal Pemakaian Kendaraan Dinas</h2>
            <p class="text-xs text-slate-500 mt-1">Klik kotak peminjaman untuk melihat rincian peminjam. Klik nama mobil untuk membuka kalender unit.</p>
        </div>
        <div class="week-nav">
            <a class="btn btn-ghost btn-sm" href="/dashboard?start=<%= matrix.prevIso %>#jadwal"><svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5L8.25 12l7.5-7.5"/></svg> 7 Hari Sebelumnya</a>
            <span class="week-label"><%= matrix.rangeLabel %></span>
            <a class="btn <%= matrix.isCurrentWeek ? 'btn-soft' : 'btn-ghost' %> btn-sm" href="/dashboard#jadwal">Hari Ini</a>
            <a class="btn btn-ghost btn-sm" href="/dashboard?start=<%= matrix.nextIso %>#jadwal">7 Hari Berikutnya <svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8.25 4.5l7.5 7.5-7.5 7.5"/></svg></a>
        </div>
    </div>

    <div class="legend">
        <span><i class="lg-free"></i>Tersedia</span>
        <span><i class="lg-booked"></i>Ter-booking</span>
        <span><i class="lg-maint"></i>Maintenance</span>
    </div>

    <div class="mx-wrap" tabindex="0" role="region" aria-label="Tabel jadwal pemakaian kendaraan">
        <table class="mx">
            <colgroup>
                <col class="mx-col-unit">
                <% matrix.days.forEach(() => { %><col><% }) %>
            </colgroup>
            <thead>
                <tr>
                    <th scope="col" class="mx-unit">Unit Kendaraan</th>
                    <% matrix.days.forEach(d => { %>
                    <th scope="col" class="<%= d.isToday ? 'is-today' : '' %> <%= d.isWeekend ? 'is-weekend' : '' %>"><%= d.label %><small><%= d.dow %></small></th>
                    <% }) %>
                </tr>
            </thead>
            <tbody>
                <% if (matrix.rows.length === 0) { %>
                    <tr><td colspan="8" class="t-empty" style="padding:2rem 1rem;text-align:center;color:var(--faint);">Belum ada unit kendaraan yang terdaftar.</td></tr>
                <% } %>
                <% matrix.rows.forEach(r => { const m = r.mobil; %>
                <tr>
                    <th scope="row" class="mx-unit">
                        <div class="unit-top">
                            <span class="plate plate-sm"><%= m.plat_nomor %></span>
                            <% if (m.status === 'MAINTENANCE') { %>
                                <span class="badge badge-maint">MAINTENANCE</span>
                            <% } else if (m.is_booked || m.status === 'DIPINJAM') { %>
                                <span class="badge badge-busy">Booked</span>
                            <% } else { %>
                                <span class="badge badge-free">FREE</span>
                            <% } %>
                        </div>
                        <button type="button" class="unit-name" data-id="<%= m.id %>" data-merk="<%= m.merk_tipe %>" data-plat="<%= m.plat_nomor %>" data-status="<%= m.status %>" onclick="openJadwalModal(this)"><%= m.merk_tipe %></button>
                        <span class="unit-meta"><%= m.kategori %> &middot; <%= m.kapasitas %> Seat</span>
                        <span class="unit-note" title="<%= m.kondapat_catatan || 'Siap pakai' %>">Kondisi: <%= m.kondapat_catatan || 'Siap pakai' %></span>
                    </th>
                    <% r.cells.forEach(c => { %>
                        <% if (c.type === 'maint') { %>
                            <td colspan="7" class="day"><div class="cell cell-maint"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/></svg> Maintenance - unit terkunci sampai admin mengubah status menjadi FREE</div></td>
                        <% } else if (c.type === 'booked') { %>
                            <td colspan="<%= c.span %>" class="day">
                                <button type="button" class="cell cell-booked <%= c.own ? 'is-own' : '' %> <%= c.clipL ? 'clip-l' : '' %> <%= c.clipR ? 'clip-r' : '' %>"
                                    title="<%= c.nama %> (<%= c.seksi || '-' %>) | <%= c.tujuan %> | <%= c.mulai %> s/d <%= c.selesai %>"
                                    data-id="<%= m.id %>" data-merk="<%= m.merk_tipe %>" data-plat="<%= m.plat_nomor %>" data-status="<%= m.status %>"
                                    onclick="openJadwalModal(this)">
                                    <span class="cell-name"><%= c.own ? 'Saya - ' : '' %><%= c.nama %></span>
                                    <span class="cell-sub"><%= c.seksi || '-' %></span>
                                </button>
                            </td>
                        <% } else if (c.type === 'free') { %>
                            <td class="day"><div class="cell cell-free" title="Tersedia"></div></td>
                        <% } else { %>
                            <td class="day"><div class="cell cell-off" aria-hidden="true" title="<%= c.type === 'far' ? 'Tanggal mulai booking maksimal 7 hari dari hari ini' : 'Tanggal sudah lewat' %>">&ndash;</div></td>
                        <% } %>
                    <% }) %>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</section>

<!-- Form Tambah Mobil (bisa dilipat) -->
<details class="card mb-8">
    <summary>
        <span class="inline-flex items-center justify-center w-6 h-6 rounded-md bg-brandBlue text-white" style="padding:.2rem;"><svg fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg></span>
        <span class="section-title">Tambah Unit Mobil Dinas Baru</span>
        <svg class="chev" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"/></svg>
    </summary>
    <form action="/dashboard/mobil/tambah" method="POST" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4 p-4 sm:p-6">
        <div>
            <label for="add_plat" class="label">Plat Nomor</label>
            <input type="text" id="add_plat" name="plat_nomor" placeholder="Contoh: B 1024 RFS" required autocomplete="off" class="field">
        </div>
        <div>
            <label for="add_merk" class="label">Merek &amp; Tipe</label>
            <input type="text" id="add_merk" name="merk_tipe" placeholder="Contoh: Toyota Innova" required autocomplete="off" class="field">
        </div>
        <div>
            <label for="add_kategori" class="label">Kategori</label>
            <input type="text" id="add_kategori" name="kategori" placeholder="MPV / SUV / Sedan" required autocomplete="off" class="field">
        </div>
        <div>
            <label for="add_kapasitas" class="label">Kapasitas Kursi</label>
            <input type="number" id="add_kapasitas" name="kapasitas" placeholder="Jumlah kursi" required class="field">
        </div>
        <div>
            <label for="add_tahun" class="label">Tahun Pembuatan</label>
            <input type="number" id="add_tahun" name="tahun" placeholder="Contoh: 2022" required class="field">
        </div>
        <div>
            <label for="add_catatan" class="label">Catatan Kondisi Awal</label>
            <input type="text" id="add_catatan" name="kondapat_catatan" placeholder="Opsional" autocomplete="off" class="field">
        </div>
        <button type="submit" class="btn btn-primary sm:col-span-2 lg:col-span-3">Simpan Mobil</button>
    </form>
</details>

<!-- Daftar Armada (tabel) -->
<section class="card p-4 sm:p-6 mb-8" aria-labelledby="kelolaTitle">
    <h2 id="kelolaTitle" class="section-title mb-4">Kelola Daftar Mobil<span class="count-chip"><%= mobilList.length %> unit</span></h2>

    <div class="tbl-wrap">
        <table class="tbl" style="min-width:56rem;">
            <thead>
                <tr>
                    <th>Unit</th>
                    <th>Kategori</th>
                    <th>Kapasitas</th>
                    <th>Tahun</th>
                    <th>Status</th>
                    <th>Catatan Kondisi</th>
                    <th>Aksi</th>
                </tr>
            </thead>
            <tbody>
                <% if (mobilList.length === 0) { %>
                    <tr><td colspan="7" class="t-empty">Belum ada unit mobil. Tambahkan unit pertama lewat form di atas.</td></tr>
                <% } %>
                <% mobilList.forEach(m => { %>
                <tr>
                    <td class="whitespace-nowrap"><span class="plate plate-sm"><%= m.plat_nomor %></span><span class="t-strong" style="display:block;margin-top:.3rem;"><%= m.merk_tipe %></span></td>
                    <td><%= m.kategori %></td>
                    <td class="whitespace-nowrap"><%= m.kapasitas %> Seat</td>
                    <td><%= m.tahun %></td>
                    <td class="whitespace-nowrap">
                        <% if (m.status === 'MAINTENANCE') { %>
                            <span class="badge badge-maint">MAINTENANCE</span>
                        <% } else if (m.is_booked || m.status === 'DIPINJAM') { %>
                            <span class="badge badge-busy">Booked</span>
                        <% } else { %>
                            <span class="badge badge-free">FREE</span>
                        <% } %>
                    </td>
                    <td><%= m.kondapat_catatan || '-' %></td>
                    <td class="whitespace-nowrap">
                        <div class="flex gap-2">
                            <button type="button"
                                data-id="<%= m.id %>"
                                data-plat="<%= m.plat_nomor %>"
                                data-merk="<%= m.merk_tipe %>"
                                data-kategori="<%= m.kategori %>"
                                data-kapasitas="<%= m.kapasitas %>"
                                data-tahun="<%= m.tahun %>"
                                data-status="<%= m.status %>"
                                data-catatan="<%= m.kondapat_catatan || '' %>"
                                onclick="openEditModal(this)"
                                class="btn btn-soft btn-sm">Edit</button>
                            <form action="/dashboard/mobil/hapus" method="POST" data-confirm="Apakah Anda yakin ingin menghapus mobil <%= m.merk_tipe %> (<%= m.plat_nomor %>)?" onsubmit="return confirm(this.dataset.confirm);">
                                <input type="hidden" name="mobil_id" value="<%= m.id %>">
                                <button type="submit" class="btn btn-danger btn-sm">Hapus</button>
                            </form>
                        </div>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</section>

<!-- Laporan Log Peminjaman Berdasarkan Kategori & Filter (2 Pilihan: Bulan & No Kendaraan) -->
<section class="card p-4 sm:p-6" aria-labelledby="logTitle">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-5">
        <div>
            <h2 id="logTitle" class="section-title">Log Peminjaman Pegawai</h2>
            <p class="text-xs text-slate-500 mt-1">
                <%= showAll ? 'Menampilkan seluruh riwayat' : 'Menampilkan transaksi terfilter (urut tanggal termuda)' %>
            </p>
        </div>

        <!-- Form Filter 2 Opsi: Bulan & No. Kendaraan -->
        <form action="/dashboard" method="GET" class="flex flex-wrap items-center gap-2">
            <input type="hidden" name="start" value="<%= matrix.startIso %>">
            <!-- 1. Filter Bulan & Tahun -->
            <select name="bulan" aria-label="Filter bulan" class="field field-sm" style="width:auto;">
                <option value=""> Filter Bulan </option>
                <% ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'].forEach((namaBulan, i) => { %>
                <option value="<%= i + 1 %>" <%= String(selectedBulan) === String(i + 1) ? 'selected' : '' %>><%= namaBulan %></option>
                <% }) %>
            </select>
            <input type="number" name="tahun" aria-label="Tahun" value="<%= selectedTahun %>" class="field field-sm field-year">

            <!-- 2. Filter No Kendaraan / Mobil -->
            <select name="mobil_id" aria-label="Filter Kendaraan" class="field field-sm" style="width:auto;">
                <option value=""> Filter No. Kendaraan </option>
                <% mobilList.forEach(m => { %>
                <option value="<%= m.id %>" <%= String(selectedMobilId) === String(m.id) ? 'selected' : '' %>><%= m.plat_nomor %> - <%= m.merk_tipe %></option>
                <% }) %>
            </select>

            <button type="submit" class="btn btn-primary btn-sm">Filter</button>

            <% if(showAll) { %>
                <a href="/dashboard" class="btn btn-ghost btn-sm">1 Bulan Terakhir</a>
            <% } else { %>
                <a href="/dashboard?show_all=true" class="btn btn-amber btn-sm">Lihat Semua Riwayat</a>
            <% } %>
        </form>
    </div>

    <!-- Navigation Tabs Kategori -->
    <div class="seg mb-4" role="tablist">
        <button type="button" onclick="switchTab('approved')" id="tab-approved" role="tab" aria-selected="true" class="is-active">
            Sedang Dipinjam (<%= approvedList.length %>)
        </button>
        <button type="button" onclick="switchTab('finished')" id="tab-finished" role="tab" aria-selected="false">
            Selesai / Ditolak (<%= finishedList.length %>)
        </button>
    </div>

    <!-- TAB 1: SEDANG DIPINJAM (APPROVED) -->
    <div id="content-approved">
        <div class="tbl-wrap">
            <table class="tbl">
                <thead>
                    <tr>
                        <th>Peminjam</th>
                        <th>Seksi / Unit</th>
                        <th>Mobil</th>
                        <th>Tujuan</th>
                        <th>Durasi</th>
                        <th>Opsi / Batal</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (approvedList.length === 0) { %>
                        <tr><td colspan="6" class="t-empty">Tidak ada mobil yang sedang dipinjam.</td></tr>
                    <% } %>
                    <% approvedList.forEach(p => { %>
                    <tr>
                        <td class="whitespace-nowrap"><span class="t-strong"><%= p.nama_user %></span><span class="t-sub">@<%= p.username %></span></td>
                        <td><%= p.nama_seksi || '-' %></td>
                        <td class="whitespace-nowrap"><span class="t-strong"><%= p.merk_tipe %></span><span class="t-sub"><%= p.plat_nomor %></span></td>
                        <td><%= p.tujuan_peminjaman %></td>
                        <td class="whitespace-nowrap"><span class="t-strong"><%= p.lama_pinjam_hari %> Hari</span><span class="t-sub"><%= p.tgl_mulai_fmt %> - <%= p.tgl_selesai_fmt %></span></td>
                        <td class="whitespace-nowrap">
                            <form action="/dashboard/admin/peminjaman/status" method="POST" onsubmit="return confirm('Batalkan/Reject peminjaman ini? Jadwal booking akan dihapus dari kalender.');">
                                <input type="hidden" name="peminjaman_id" value="<%= p.id %>">
                                <input type="hidden" name="mobil_id" value="<%= p.mobil_id %>">
                                <input type="hidden" name="status_peminjaman" value="REJECTED">
                                <button type="submit" class="btn btn-danger btn-sm">Batalkan (Reject)</button>
                            </form>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- TAB 2: FINISHED / REJECTED -->
    <div id="content-finished" class="hidden">
        <div class="tbl-wrap">
            <table class="tbl">
                <thead>
                    <tr>
                        <th>Peminjam</th>
                        <th>Seksi / Unit</th>
                        <th>Mobil</th>
                        <th>Tujuan</th>
                        <th>Durasi</th>
                        <th>Status Akhir</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (finishedList.length === 0) { %>
                        <tr><td colspan="6" class="t-empty">Belum ada riwayat peminjaman selesai/ditolak.</td></tr>
                    <% } %>
                    <% finishedList.forEach(p => { %>
                    <tr>
                        <td class="whitespace-nowrap"><span class="t-strong"><%= p.nama_user %></span><span class="t-sub">@<%= p.username %></span></td>
                        <td><%= p.nama_seksi || '-' %></td>
                        <td class="whitespace-nowrap"><span class="t-strong"><%= p.merk_tipe %></span><span class="t-sub"><%= p.plat_nomor %></span></td>
                        <td><%= p.tujuan_peminjaman %></td>
                        <td class="whitespace-nowrap"><span class="t-strong"><%= p.lama_pinjam_hari %> Hari</span><span class="t-sub"><%= p.tgl_mulai_fmt %> - <%= p.tgl_selesai_fmt %></span></td>
                        <td class="whitespace-nowrap">
                            <% if(p.status_peminjaman === 'RETURNED') { %>
                                <span class="badge badge-done">RETURNED</span>
                            <% } else { %>
                                <span class="badge badge-maint">DIBATALKAN / REJECTED</span>
                            <% } %>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</section>

<!-- Modal Pop-Up Edit Mobil -->
<div id="editModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center z-50 p-2 sm:p-4">
    <div class="modal-panel max-w-lg max-h-[90vh] overflow-y-auto" role="dialog" aria-modal="true" aria-labelledby="editModalTitle">
        <div class="modal-head">
            <h3 id="editModalTitle" class="modal-title">Edit Data Mobil</h3>
            <button type="button" onclick="closeEditModal()" class="icon-btn" aria-label="Tutup"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg></button>
        </div>
        <form action="/dashboard/mobil/edit" method="POST" class="space-y-3">
            <input type="hidden" id="edit_mobil_id" name="mobil_id">

            <div>
                <label for="edit_plat_nomor" class="label">Plat Nomor</label>
                <input type="text" id="edit_plat_nomor" name="plat_nomor" required class="field">
            </div>
            <div>
                <label for="edit_merk_tipe" class="label">Merek &amp; Tipe</label>
                <input type="text" id="edit_merk_tipe" name="merk_tipe" required class="field">
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label for="edit_kategori" class="label">Kategori</label>
                    <input type="text" id="edit_kategori" name="kategori" required class="field">
                </div>
                <div>
                    <label for="edit_kapasitas" class="label">Kapasitas (Seat)</label>
                    <input type="number" id="edit_kapasitas" name="kapasitas" required class="field">
                </div>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label for="edit_tahun" class="label">Tahun Pembuatan</label>
                    <input type="number" id="edit_tahun" name="tahun" required class="field">
                </div>
                <div>
                    <label for="edit_status" class="label">Status Mobil</label>
                    <select id="edit_status" name="status" class="field">
                        <option value="FREE">FREE</option>
                        <option value="DIPINJAM">DIPINJAM</option>
                        <option value="MAINTENANCE">MAINTENANCE</option>
                    </select>
                </div>
            </div>
            <div>
                <label for="edit_kondapat_catatan" class="label">Catatan Kondisi</label>
                <input type="text" id="edit_kondapat_catatan" name="kondapat_catatan" class="field">
            </div>

            <div class="modal-foot">
                <button type="button" onclick="closeEditModal()" class="btn btn-ghost">Batal</button>
                <button type="submit" class="btn btn-primary">Simpan Perubahan</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Jadwal Unit (kalender + daftar peminjam) -->
<div id="jadwalModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center z-50 p-2 sm:p-4">
    <div class="modal-panel max-w-md max-h-[92vh] overflow-y-auto" role="dialog" aria-modal="true" aria-labelledby="jadwalMobilTitle">
        <div class="modal-head">
            <div class="min-w-0">
                <h3 id="jadwalMobilTitle" class="modal-title"></h3>
                <p id="jadwalMobilPlat" class="plate plate-sm mt-1"></p>
            </div>
            <button type="button" onclick="closeJadwalModal()" class="icon-btn" aria-label="Tutup"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg></button>
        </div>

        <div class="cal-box fp-readonly"><input type="text" id="jadwalCalendar" class="hidden" tabindex="-1" aria-hidden="true"></div>
        <p class="hint text-center">Tanggal berlatar <strong>kuning</strong> sudah ter-booking.</p>

        <div class="mt-4">
            <h4 class="label mb-2">Daftar Rincian Peminjam</h4>
            <div id="jadwalList"><p class="text-xs text-slate-400">Memuat data jadwal...</p></div>
        </div>

        <div class="modal-foot">
            <button type="button" onclick="closeJadwalModal()" class="btn btn-ghost">Tutup</button>
        </div>
    </div>
</div>

<script>
// ---------- Utilitas ----------
function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
}
const CAL_ICON = '<svg class="inline-block w-3.5 h-3.5 -mt-0.5 mr-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/></svg>';
const LOCALE_ID = (window.flatpickr && flatpickr.l10ns && flatpickr.l10ns.id) ? flatpickr.l10ns.id : 'default';

function pad2(n) { return String(n).padStart(2, '0'); }
function dayIso(d) { return d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate()); }
function inRanges(iso, ranges) { return ranges.some(function (r) { return iso >= r.from && iso <= r.to; }); }
function toRange(item) { return { from: item.tgl_mulai.split('T')[0], to: item.tgl_selesai.split('T')[0] }; }
function fmtLong(d) { return d.toLocaleDateString('id-ID', { weekday: 'short', day: 'numeric', month: 'short', year: 'numeric' }); }

function openModal(id) {
    document.body.classList.add('overflow-hidden');
    const m = document.getElementById(id);
    m.classList.remove('hidden');
    m.classList.add('flex');
}
function closeModal(id) {
    document.body.classList.remove('overflow-hidden');
    const m = document.getElementById(id);
    m.classList.add('hidden');
    m.classList.remove('flex');
}

// ---------- Modal Jadwal Unit (kalender baca-saja + daftar peminjam) ----------
let fpView = null;

function renderJadwalList(data) {
    const container = document.getElementById('jadwalList');
    if (data.length === 0) {
        container.innerHTML = '<div class="sched-empty">Belum ada jadwal booking. Mobil ini bebas dipinjam.</div>';
        return;
    }
    let html = '';
    data.forEach(function (item) {
        const tglStart = item.tgl_mulai_str || item.tgl_mulai.split('T')[0];
        const tglEnd = item.tgl_selesai_str || item.tgl_selesai.split('T')[0];
        html += '<div class="sched-item">' +
            '<div class="flex justify-between items-center gap-2">' +
                '<span class="font-bold text-slate-900 truncate">' + esc(item.nama_peminjam) + ' (' + esc(item.nama_seksi || '-') + ')</span>' +
                '<span class="badge badge-free shrink-0">APPROVED</span>' +
            '</div>' +
            '<p class="text-slate-600 break-words mt-1"><strong>Tujuan:</strong> ' + esc(item.tujuan_peminjaman) + '</p>' +
            '<p class="text-brandBlue font-semibold mt-1">' + CAL_ICON + tglStart + ' s/d ' + tglEnd + '</p>' +
        '</div>';
    });
    container.innerHTML = html;
}

function closeJadwalModal() {
    closeModal('jadwalModal');
}

function openJadwalModal(el) {
    document.getElementById('jadwalMobilTitle').innerText = el.dataset.merk;
    document.getElementById('jadwalMobilPlat').innerText = el.dataset.plat;
    document.getElementById('jadwalList').innerHTML = '<p class="text-xs text-slate-400">Memuat data jadwal...</p>';
    openModal('jadwalModal');

    fetch('/dashboard/mobil/' + encodeURIComponent(el.dataset.id) + '/jadwal')
        .then(function (res) { return res.json(); })
        .then(function (data) {
            if (!Array.isArray(data)) throw new Error('format');
            const ranges = data.map(toRange);
            if (fpView) { fpView.destroy(); fpView = null; }
            fpView = flatpickr('#jadwalCalendar', {
                inline: true,
                locale: LOCALE_ID,
                onDayCreate: function (dObj, dStr, fp, dayElem) {
                    if (inRanges(dayIso(dayElem.dateObj), ranges)) {
                        dayElem.classList.add('booked-date');
                        dayElem.title = 'Sudah ter-booking';
                    }
                }
            });
            renderJadwalList(data);
        })
        .catch(function () {
            document.getElementById('jadwalList').innerHTML = '<p class="text-xs text-rose-600">Gagal memuat jadwal peminjaman.</p>';
        });
}

function switchTab(category) {
    ['approved', 'finished'].forEach(function (cat) {
        const tabBtn = document.getElementById('tab-' + cat);
        const contentDiv = document.getElementById('content-' + cat);
        if (cat === category) {
            tabBtn.classList.add('is-active');
            tabBtn.setAttribute('aria-selected', 'true');
            contentDiv.classList.remove('hidden');
        } else {
            tabBtn.classList.remove('is-active');
            tabBtn.setAttribute('aria-selected', 'false');
            contentDiv.classList.add('hidden');
        }
    });
}

function openEditModal(btn) {
    document.getElementById('edit_mobil_id').value = btn.getAttribute('data-id');
    document.getElementById('edit_plat_nomor').value = btn.getAttribute('data-plat');
    document.getElementById('edit_merk_tipe').value = btn.getAttribute('data-merk');
    document.getElementById('edit_kategori').value = btn.getAttribute('data-kategori');
    document.getElementById('edit_kapasitas').value = btn.getAttribute('data-kapasitas');
    document.getElementById('edit_tahun').value = btn.getAttribute('data-tahun');
    document.getElementById('edit_status').value = btn.getAttribute('data-status');
    document.getElementById('edit_kondapat_catatan').value = btn.getAttribute('data-catatan');
    openModal('editModal');
}

function closeEditModal() {
    closeModal('editModal');
}
</script>

