<%- include('partials/header') %>

<!-- Flatpickr CSS & JS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<style>
  .flatpickr-calendar {
    font-family: inherit !important;
    border-radius: 14px !important;
    box-shadow: 0 18px 40px -10px rgba(14, 42, 92, 0.3) !important;
    border: 1px solid #DCE2EC !important;
    z-index: 9999 !important;
  }
  .flatpickr-current-month {
    font-family: inherit !important;
    font-weight: 700 !important;
  }
  .flatpickr-current-month .flatpickr-monthDropdown-months,
  .flatpickr-current-month input.cur-year {
    font-family: inherit !important;
    font-weight: 700 !important;
  }
  .flatpickr-day.booked-date {
    background-color: #fef08a !important;
    color: #854d0e !important;
    font-weight: 700 !important;
    border-radius: 9999px !important;
    border: 1px solid #fde047 !important;
    max-width: 28px !important;
    height: 28px !important;
    line-height: 26px !important;
    margin: 2px auto !important;
  }
</style>

<div class="mb-6 sm:mb-8">
    <h1 class="page-title">Panel Kontrol Administrator</h1>
    <p class="page-sub">Kelola armada mobil dinas, pantau aktivitas, dan batalkan peminjaman jika diperlukan.</p>
</div>

<!-- Form Tambah Mobil -->
<section class="card p-4 sm:p-6 mb-8" aria-labelledby="tambahTitle">
    <h2 id="tambahTitle" class="section-title mb-4 flex items-center gap-2">
        <span class="inline-flex items-center justify-center w-6 h-6 rounded-md bg-brandBlue text-white"><svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg></span>
        Tambah Unit Mobil Dinas Baru
    </h2>
    <form action="/dashboard/mobil/tambah" method="POST" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
        <div>
            <label for="add_plat" class="label">Plat Nomor</label>
            <input type="text" id="add_plat" name="plat_nomor" placeholder="Contoh: B 1024 RFS" required class="field">
        </div>
        <div>
            <label for="add_merk" class="label">Merek &amp; Tipe</label>
            <input type="text" id="add_merk" name="merk_tipe" placeholder="Contoh: Toyota Innova" required class="field">
        </div>
        <div>
            <label for="add_kategori" class="label">Kategori</label>
            <input type="text" id="add_kategori" name="kategori" placeholder="MPV / SUV / Sedan" required class="field">
        </div>
        <div>
            <label for="add_kapasitas" class="label">Kapasitas Kursi</label>
            <input type="number" id="add_kapasitas" name="kapasitas" placeholder="Jumlah kursi" required class="field">
        </div>
        <div>
            <label for="add_tahun" class="label">Tahun Pembuatan</label>
            <input type="number" id="add_tahun" name="tahun" placeholder="Contoh: 2022" required class="field">
        </div>
        <div>
            <label for="add_catatan" class="label">Catatan Kondisi Awal</label>
            <input type="text" id="add_catatan" name="kondapat_catatan" placeholder="Opsional" class="field">
        </div>
        <button type="submit" class="btn btn-primary sm:col-span-2 lg:col-span-3">Simpan Mobil</button>
    </form>
</section>

<!-- Daftar Armada Mobil -->
<section class="mb-10" aria-labelledby="kelolaTitle">
    <h2 id="kelolaTitle" class="section-title mb-4">Kelola Daftar Mobil<span class="count-chip"><%= mobilList.length %> unit</span></h2>

    <% if (mobilList.length === 0) { %>
        <div class="card p-8 text-center text-sm text-slate-500">Belum ada unit mobil. Tambahkan unit pertama lewat form di atas.</div>
    <% } %>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
        <% mobilList.forEach(m => { %>
        <article class="car-card">
            <div class="car-top">
                <span class="plate"><%= m.plat_nomor %></span>
                <% if(m.status === 'FREE') { %>
                    <span class="badge badge-free">FREE</span>
                <% } else if(m.status === 'DIPINJAM') { %>
                    <span class="badge badge-busy">DIPINJAM</span>
                <% } else { %>
                    <span class="badge badge-maint">MAINTENANCE</span>
                <% } %>
            </div>

            <div>
                <h3 class="car-name"><%= m.merk_tipe %></h3>
            </div>

            <dl class="spec">
                <div><dt>Kategori</dt><dd><%= m.kategori %></dd></div>
                <div><dt>Kapasitas</dt><dd><%= m.kapasitas %> Seat</dd></div>
                <div><dt>Tahun</dt><dd><%= m.tahun %></dd></div>
            </dl>

            <p class="car-note"><strong>Catatan:</strong> <%= m.kondapat_catatan || '-' %></p>

            <!-- Tombol Opsi Edit, Hapus & Cek Jadwal -->
            <div class="car-actions">
                <button type="button"
                    data-id="<%= m.id %>" data-merk="<%= m.merk_tipe %>" data-plat="<%= m.plat_nomor %>"
                    onclick="openAdminJadwalModal(this.dataset.id, this.dataset.merk, this.dataset.plat)"
                    class="btn btn-amber btn-block">
                    <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/></svg>
                    Lihat Jadwal &amp; Kalender Booking
                </button>
                <div class="btn-row">
                    <button type="button"
                        data-id="<%= m.id %>"
                        data-plat="<%= m.plat_nomor %>"
                        data-merk="<%= m.merk_tipe %>"
                        data-kategori="<%= m.kategori %>"
                        data-kapasitas="<%= m.kapasitas %>"
                        data-tahun="<%= m.tahun %>"
                        data-status="<%= m.status %>"
                        data-catatan="<%= m.kondapat_catatan || '' %>"
                        onclick="openEditModal(this)"
                        class="btn btn-soft">
                        <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10"/></svg>
                        Edit
                    </button>
                    <form action="/dashboard/mobil/hapus" method="POST" data-confirm="Apakah Anda yakin ingin menghapus mobil <%= m.merk_tipe %> (<%= m.plat_nomor %>)?" onsubmit="return confirm(this.dataset.confirm);">
                        <input type="hidden" name="mobil_id" value="<%= m.id %>">
                        <button type="submit" class="btn btn-danger btn-block">
                            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/></svg>
                            Hapus
                        </button>
                    </form>
                </div>
            </div>
        </article>
        <% }) %>
    </div>
</section>

<!-- Laporan Log Peminjaman Berdasarkan Kategori & Filter -->
<section class="card p-4 sm:p-6" aria-labelledby="logTitle">
    <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-5">
        <div>
            <h2 id="logTitle" class="section-title">Log Peminjaman Pegawai</h2>
            <p class="text-xs text-slate-500 mt-1">
                <%= showAll ? 'Menampilkan seluruh riwayat' : 'Menampilkan transaksi 1 bulan terakhir' %>
            </p>
        </div>

        <!-- Filter Bulan & Opsi Tampilkan Semua -->
        <form action="/dashboard" method="GET" class="flex flex-wrap items-center gap-2">
            <select name="bulan" aria-label="Filter bulan" class="field field-sm" style="width:auto;">
                <option value="">-- Filter Bulan --</option>
                <% ['Januari','Februari','Maret','April','Mei','Juni','Juli','Agustus','September','Oktober','November','Desember'].forEach((namaBulan, i) => { %>
                <option value="<%= i + 1 %>" <%= String(selectedBulan) === String(i + 1) ? 'selected' : '' %>><%= namaBulan %></option>
                <% }) %>
            </select>
            <input type="number" name="tahun" aria-label="Tahun" value="<%= selectedTahun %>" class="field field-sm field-year">
            <button type="submit" class="btn btn-primary btn-sm">Filter</button>

            <% if(showAll) { %>
                <a href="/dashboard" class="btn btn-ghost btn-sm">1 Bulan Terakhir</a>
            <% } else { %>
                <a href="/dashboard?show_all=true" class="btn btn-amber btn-sm">Lihat Semua Riwayat</a>
            <% } %>
        </form>
    </div>

    <!-- Navigation Tabs Kategori (Dua Tab: Sedang Dipinjam & Selesai/Ditolak) -->
    <div class="seg mb-4" role="tablist">
        <button type="button" onclick="switchTab('approved')" id="tab-approved" role="tab" aria-selected="true" class="is-active">
            Sedang Dipinjam (<%= approvedList.length %>)
        </button>
        <button type="button" onclick="switchTab('finished')" id="tab-finished" role="tab" aria-selected="false">
            Selesai / Ditolak (<%= finishedList.length %>)
        </button>
    </div>

    <!-- TAB 1: SEDANG DIPINJAM (APPROVED) -->
    <div id="content-approved">
        <div class="tbl-wrap">
            <table class="tbl">
                <thead>
                    <tr>
                        <th>Peminjam</th>
                        <th>Seksi / Unit</th>
                        <th>Mobil</th>
                        <th>Tujuan</th>
                        <th>Durasi</th>
                        <th>Opsi / Batal</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (approvedList.length === 0) { %>
                        <tr><td colspan="6" class="t-empty">Tidak ada mobil yang sedang dipinjam.</td></tr>
                    <% } %>
                    <% approvedList.forEach(p => { %>
                    <tr>
                        <td class="whitespace-nowrap"><span class="t-strong"><%= p.nama_user %></span><span class="t-sub">@<%= p.username %></span></td>
                        <td><%= p.nama_seksi || '-' %></td>
                        <td class="whitespace-nowrap"><span class="t-strong"><%= p.merk_tipe %></span><br><span class="plate plate-sm mt-1"><%= p.plat_nomor %></span></td>
                        <td><%= p.tujuan_peminjaman %></td>
                        <td class="whitespace-nowrap"><span class="t-strong"><%= p.lama_pinjam_hari %> Hari</span><span class="t-sub"><%= new Date(p.tgl_mulai).toLocaleDateString('id-ID') %> - <%= new Date(p.tgl_selesai).toLocaleDateString('id-ID') %></span></td>
                        <td class="whitespace-nowrap">
                            <form action="/dashboard/admin/peminjaman/status" method="POST" onsubmit="return confirm('Batalkan/Reject peminjaman ini? Jadwal booking akan dihapus dari kalender.');">
                                <input type="hidden" name="peminjaman_id" value="<%= p.id %>">
                                <input type="hidden" name="mobil_id" value="<%= p.mobil_id %>">
                                <input type="hidden" name="status_peminjaman" value="REJECTED">
                                <button type="submit" class="btn btn-danger btn-sm">Batalkan (Reject)</button>
                            </form>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- TAB 2: FINISHED / REJECTED -->
    <div id="content-finished" class="hidden">
        <div class="tbl-wrap">
            <table class="tbl">
                <thead>
                    <tr>
                        <th>Peminjam</th>
                        <th>Seksi / Unit</th>
                        <th>Mobil</th>
                        <th>Tujuan</th>
                        <th>Durasi</th>
                        <th>Status Akhir</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (finishedList.length === 0) { %>
                        <tr><td colspan="6" class="t-empty">Belum ada riwayat peminjaman selesai/ditolak.</td></tr>
                    <% } %>
                    <% finishedList.forEach(p => { %>
                    <tr>
                        <td class="whitespace-nowrap"><span class="t-strong"><%= p.nama_user %></span><span class="t-sub">@<%= p.username %></span></td>
                        <td><%= p.nama_seksi || '-' %></td>
                        <td class="whitespace-nowrap"><span class="t-strong"><%= p.merk_tipe %></span><br><span class="plate plate-sm mt-1"><%= p.plat_nomor %></span></td>
                        <td><%= p.tujuan_peminjaman %></td>
                        <td class="whitespace-nowrap"><span class="t-strong"><%= p.lama_pinjam_hari %> Hari</span><span class="t-sub"><%= new Date(p.tgl_mulai).toLocaleDateString('id-ID') %> - <%= new Date(p.tgl_selesai).toLocaleDateString('id-ID') %></span></td>
                        <td class="whitespace-nowrap">
                            <% if(p.status_peminjaman === 'RETURNED') { %>
                                <span class="badge badge-done">RETURNED</span>
                            <% } else { %>
                                <span class="badge badge-maint">DIBATALKAN / REJECTED</span>
                            <% } %>
                        </td>
                    </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</section>

<!-- Modal Pop-Up Edit Mobil -->
<div id="editModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center z-50 p-3 sm:p-4">
    <div class="modal-panel max-w-lg max-h-[90vh] overflow-y-auto" role="dialog" aria-modal="true" aria-labelledby="editModalTitle">
        <div class="modal-head">
            <h3 id="editModalTitle" class="modal-title">Edit Data Mobil</h3>
            <button type="button" onclick="closeEditModal()" class="icon-btn" aria-label="Tutup"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg></button>
        </div>
        <form action="/dashboard/mobil/edit" method="POST" class="space-y-3">
            <input type="hidden" id="edit_mobil_id" name="mobil_id">

            <div>
                <label for="edit_plat_nomor" class="label">Plat Nomor</label>
                <input type="text" id="edit_plat_nomor" name="plat_nomor" required class="field">
            </div>
            <div>
                <label for="edit_merk_tipe" class="label">Merek &amp; Tipe</label>
                <input type="text" id="edit_merk_tipe" name="merk_tipe" required class="field">
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label for="edit_kategori" class="label">Kategori</label>
                    <input type="text" id="edit_kategori" name="kategori" required class="field">
                </div>
                <div>
                    <label for="edit_kapasitas" class="label">Kapasitas (Seat)</label>
                    <input type="number" id="edit_kapasitas" name="kapasitas" required class="field">
                </div>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label for="edit_tahun" class="label">Tahun Pembuatan</label>
                    <input type="number" id="edit_tahun" name="tahun" required class="field">
                </div>
                <div>
                    <label for="edit_status" class="label">Status Mobil</label>
                    <select id="edit_status" name="status" class="field">
                        <option value="FREE">FREE</option>
                        <option value="DIPINJAM">DIPINJAM</option>
                        <option value="MAINTENANCE">MAINTENANCE</option>
                    </select>
                </div>
            </div>
            <div>
                <label for="edit_kondapat_catatan" class="label">Catatan Kondisi</label>
                <input type="text" id="edit_kondapat_catatan" name="kondapat_catatan" class="field">
            </div>

            <div class="modal-foot">
                <button type="button" onclick="closeEditModal()" class="btn btn-ghost">Batal</button>
                <button type="submit" class="btn btn-primary">Simpan Perubahan</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Admin Cek Jadwal & Kalender -->
<div id="adminJadwalModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center z-50 p-3 sm:p-4">
    <div class="modal-panel max-w-lg max-h-[85vh] overflow-y-auto" role="dialog" aria-modal="true" aria-labelledby="adminJadwalTitle">
        <div class="modal-head">
            <div class="min-w-0">
                <h3 id="adminJadwalTitle" class="modal-title truncate"></h3>
                <p id="adminJadwalPlat" class="plate plate-sm mt-1"></p>
            </div>
            <button type="button" onclick="closeAdminJadwalModal()" class="icon-btn" aria-label="Tutup"><svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg></button>
        </div>

        <div class="space-y-5">
            <div>
                <label for="adminCalendarView" class="label">Visualisasi Kalender Booking</label>
                <input type="text" id="adminCalendarView" placeholder="Melihat Tanggal Ter-booking" class="field cursor-pointer" readonly>
            </div>

            <div>
                <h4 class="label mb-2">Daftar Rincian Peminjam</h4>
                <div id="adminJadwalList">
                    <p class="text-xs text-slate-400">Memuat data jadwal...</p>
                </div>
            </div>
        </div>

        <div class="modal-foot">
            <button type="button" onclick="closeAdminJadwalModal()" class="btn btn-ghost">Tutup</button>
        </div>
    </div>
</div>

<script>
let fpAdmin;

// Escape teks dari database sebelum dimasukkan ke innerHTML
function esc(s) {
    return String(s == null ? '' : s).replace(/[&<>"']/g, function (c) {
        return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
}

const CAL_ICON = '<svg class="inline-block w-3.5 h-3.5 -mt-0.5 mr-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/></svg>';

function switchTab(category) {
    const categories = ['approved', 'finished'];
    categories.forEach(cat => {
        const tabBtn = document.getElementById(`tab-${cat}`);
        const contentDiv = document.getElementById(`content-${cat}`);
        if (cat === category) {
            tabBtn.classList.add('is-active');
            tabBtn.setAttribute('aria-selected', 'true');
            contentDiv.classList.remove('hidden');
        } else {
            tabBtn.classList.remove('is-active');
            tabBtn.setAttribute('aria-selected', 'false');
            contentDiv.classList.add('hidden');
        }
    });
}

function openEditModal(btn) {
    document.getElementById('edit_mobil_id').value = btn.getAttribute('data-id');
    document.getElementById('edit_plat_nomor').value = btn.getAttribute('data-plat');
    document.getElementById('edit_merk_tipe').value = btn.getAttribute('data-merk');
    document.getElementById('edit_kategori').value = btn.getAttribute('data-kategori');
    document.getElementById('edit_kapasitas').value = btn.getAttribute('data-kapasitas');
    document.getElementById('edit_tahun').value = btn.getAttribute('data-tahun');
    document.getElementById('edit_status').value = btn.getAttribute('data-status');
    document.getElementById('edit_kondapat_catatan').value = btn.getAttribute('data-catatan');

    document.body.classList.add('overflow-hidden');
    const modal = document.getElementById('editModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
}

function closeEditModal() {
    document.body.classList.remove('overflow-hidden');
    const modal = document.getElementById('editModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
}

function openAdminJadwalModal(mobilId, merk, plat) {
    document.getElementById('adminJadwalTitle').innerText = merk;
    document.getElementById('adminJadwalPlat').innerText = plat;

    const container = document.getElementById('adminJadwalList');
    container.innerHTML = '<p class="text-xs text-slate-400">Memuat data jadwal...</p>';

    fetch(`/dashboard/mobil/${mobilId}/jadwal`)
        .then(res => res.json())
        .then(data => {
            const disableRanges = [];
            data.forEach(item => {
                disableRanges.push({
                    from: item.tgl_mulai.split('T')[0],
                    to: item.tgl_selesai.split('T')[0]
                });
            });

            if (fpAdmin) fpAdmin.destroy();
            fpAdmin = flatpickr("#adminCalendarView", {
                inline: false,
                dateFormat: "Y-m-d",
                disable: disableRanges,
                onDayCreate: function(dObj, dStr, fp, dayElem) {
                    const dayDate = dayElem.dateObj;
                    disableRanges.forEach(range => {
                        const start = new Date(range.from);
                        const end = new Date(range.to);
                        start.setHours(0,0,0,0);
                        end.setHours(23,59,59,999);
                        if (dayDate >= start && dayDate <= end) {
                            dayElem.classList.add("booked-date");
                            dayElem.title = "Sudah ter-booking";
                        }
                    });
                }
            });

            if (data.length === 0) {
                container.innerHTML = '<div class="sched-empty">Belum ada peminjaman terdaftar pada unit ini.</div>';
                return;
            }
            let html = '';
            data.forEach(item => {
                const tglStart = new Date(item.tgl_mulai).toLocaleDateString('id-ID', { day: '2-digit', month: '2-digit', year: 'numeric' });
                const tglEnd = new Date(item.tgl_selesai).toLocaleDateString('id-ID', { day: '2-digit', month: '2-digit', year: 'numeric' });

                html += `
                    <div class="sched-item">
                        <div class="flex justify-between items-center gap-2">
                            <span class="font-bold text-slate-900 truncate">${esc(item.nama_peminjam)} (${esc(item.nama_seksi || '-')})</span>
                            <span class="badge badge-free shrink-0">APPROVED</span>
                        </div>
                        <p class="text-slate-600 break-words mt-1"><strong>Tujuan:</strong> ${esc(item.tujuan_peminjaman)}</p>
                        <p class="text-brandBlue font-semibold mt-1">${CAL_ICON}${tglStart} s/d ${tglEnd}</p>
                    </div>
                `;
            });
            container.innerHTML = html;
        })
        .catch(err => {
            container.innerHTML = '<p class="text-xs text-rose-600">Gagal memuat jadwal peminjaman.</p>';
        });

    document.body.classList.add('overflow-hidden');
    const modal = document.getElementById('adminJadwalModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
}

function closeAdminJadwalModal() {
    document.body.classList.remove('overflow-hidden');
    const modal = document.getElementById('adminJadwalModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
}
</script>

