<%- include('partials/header') %>

<!-- Flatpickr CSS & JS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<style>
  .flatpickr-calendar {
    font-family: inherit !important;
    border-radius: 0.75rem !important;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1) !important;
    border: 1px solid #e2e8f0 !important;
    z-index: 9999 !important;
  }
  .flatpickr-day.booked-date {
    background-color: #fef08a !important;
    color: #854d0e !important;
    font-weight: 700 !important;
    border-radius: 9999px !important;
    border: 1px solid #fde047 !important;
    max-width: 28px !important;
    height: 28px !important;
    line-height: 26px !important;
    margin: 2px auto !important;
  }
</style>

<div class="mb-6 sm:mb-8">
    <h1 class="text-xl sm:text-2xl font-bold text-brandBlue">Panel Kontrol Administrator</h1>
    <p class="text-slate-500 text-xs sm:text-sm">Kelola armada mobil dinas, atur persetujuan, dan pantau aktivitas peminjaman.</p>
</div>

<!-- Form Tambah Mobil -->
<div class="bg-white border border-slate-200 rounded-xl p-4 sm:p-6 shadow-sm mb-8">
    <h2 class="text-base sm:text-lg font-bold text-slate-800 mb-4">+ Tambah Unit Mobil Dinas Baru</h2>
    <form action="/dashboard/mobil/tambah" method="POST" class="grid grid-cols-1 md:grid-cols-3 gap-3 sm:gap-4">
        <input type="text" name="plat_nomor" placeholder="Plat Nomor (Contoh: B 1024 RFS)" required class="p-2 border text-xs sm:text-sm rounded focus:outline-none focus:border-brandBlue">
        <input type="text" name="merk_tipe" placeholder="Merek & Tipe (Contoh: Toyota Innova)" required class="p-2 border text-xs sm:text-sm rounded focus:outline-none focus:border-brandBlue">
        <input type="text" name="kategori" placeholder="Kategori (MPV/SUV/Sedan)" required class="p-2 border text-xs sm:text-sm rounded focus:outline-none focus:border-brandBlue">
        <input type="number" name="kapasitas" placeholder="Kapasitas Kursi" required class="p-2 border text-xs sm:text-sm rounded focus:outline-none focus:border-brandBlue">
        <input type="number" name="tahun" placeholder="Tahun Pembuatan" required class="p-2 border text-xs sm:text-sm rounded focus:outline-none focus:border-brandBlue">
        <input type="text" name="kondapat_catatan" placeholder="Catatan Kondisi Awal" class="p-2 border text-xs sm:text-sm rounded focus:outline-none focus:border-brandBlue">
        <button type="submit" class="md:col-span-3 py-2 bg-brandBlue text-white font-bold text-xs sm:text-sm rounded hover:bg-blue-800 transition">Simpan Mobil</button>
    </form>
</div>

<!-- Daftar Armada Mobil -->
<div class="mb-10">
    <h2 class="text-base sm:text-lg font-semibold text-slate-800 mb-4 flex items-center gap-2">
        <span class="w-3 h-3 bg-brandYellow rounded-full inline-block"></span> Kelola Daftar Mobil
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
        <% mobilList.forEach(m => { %>
        <div class="bg-brandCard border border-slate-200 rounded-xl p-4 sm:p-5 shadow-sm flex flex-col justify-between">
            <div>
                <div class="flex justify-between items-start mb-3 gap-2">
                    <div class="min-w-0 flex-1">
                        <h3 class="font-bold text-base sm:text-lg text-slate-900 truncate"><%= m.merk_tipe %></h3>
                        <p class="text-[11px] sm:text-xs font-mono bg-slate-200 text-slate-700 px-2 py-0.5 rounded inline-block mt-1 break-all"><%= m.plat_nomor %></p>
                    </div>
                    <% if(m.status === 'FREE') { %>
                        <span class="px-2.5 py-1 bg-emerald-100 text-emerald-700 text-[10px] sm:text-xs font-bold rounded-full shrink-0">FREE</span>
                    <% } else if(m.status === 'DIPINJAM') { %>
                        <span class="px-2.5 py-1 bg-amber-100 text-amber-700 text-[10px] sm:text-xs font-bold rounded-full shrink-0">DIPINJAM</span>
                    <% } else { %>
                        <span class="px-2.5 py-1 bg-rose-100 text-rose-700 text-[10px] sm:text-xs font-bold rounded-full shrink-0">MAINTENANCE</span>
                    <% } %>
                </div>
                
                <div class="text-xs sm:text-sm text-slate-600 space-y-1 mb-4">
                    <p>Kategori: <strong><%= m.kategori %></strong> (<%= m.kapasitas %> Seat)</p>
                    <p>Tahun: <strong><%= m.tahun %></strong></p>
                    <p>Catatan: <span class="italic text-slate-500 break-words"><%= m.kondapat_catatan || '-' %></span></p>
                </div>
            </div>

            <!-- Tombol Opsi Edit, Hapus & Cek Jadwal -->
            <div class="pt-3 border-t border-slate-200 space-y-2">
                <button type="button" 
                    onclick="openAdminJadwalModal('<%= m.id %>', '<%= m.merk_tipe %>', '<%= m.plat_nomor %>')"
                    class="w-full py-1.5 bg-amber-50 hover:bg-amber-100 text-amber-800 font-bold text-xs rounded-lg transition border border-amber-200 flex items-center justify-center gap-1">
                    📌 Lihat Jadwal & Kalender Booking
                </button>
                <div class="flex justify-end gap-2">
                    <button type="button" 
                        data-id="<%= m.id %>"
                        data-plat="<%= m.plat_nomor %>"
                        data-merk="<%= m.merk_tipe %>"
                        data-kategori="<%= m.kategori %>"
                        data-kapasitas="<%= m.kapasitas %>"
                        data-tahun="<%= m.tahun %>"
                        data-status="<%= m.status %>"
                        data-catatan="<%= m.kondapat_catatan || '' %>"
                        onclick="openEditModal(this)" 
                        class="w-full py-1.5 bg-blue-50 hover:bg-blue-100 text-brandBlue font-bold text-xs rounded-lg transition border border-blue-200 flex items-center justify-center gap-1">
                        ✏️ Edit
                    </button>
                    <form action="/dashboard/mobil/hapus" method="POST" class="w-full" onsubmit="return confirm('Apakah Anda yakin ingin menghapus mobil <%= m.merk_tipe %> (<%= m.plat_nomor %>)?');">
                        <input type="hidden" name="mobil_id" value="<%= m.id %>">
                        <button type="submit" class="w-full py-1.5 bg-rose-50 hover:bg-rose-100 text-rose-600 font-bold text-xs rounded-lg transition border border-rose-200 flex items-center justify-center gap-1">
                            🗑️ Hapus
                        </button>
                    </form>
                </div>
            </div>
        </div>
        <% }) %>
    </div>
</div>

<!-- Laporan Log Peminjaman Berdasarkan Kategori & Filter -->
<div class="bg-white border border-slate-200 rounded-xl p-4 sm:p-6 shadow-sm">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6 pb-4 border-b">
        <div>
            <h2 class="text-base sm:text-lg font-bold text-slate-800">Log Peminjaman Pegawai</h2>
            <p class="text-xs text-slate-500">
                <%= showAll ? 'Menampilkan seluruh riwayat' : 'Menampilkan transaksi 1 bulan terakhir' %>
            </p>
        </div>

        <!-- Filter Bulan & Opsi Tampilkan Semua -->
        <form action="/dashboard" method="GET" class="flex flex-wrap items-center gap-2">
            <select name="bulan" class="p-1.5 text-xs border border-slate-300 rounded focus:outline-none bg-white">
                <option value="">-- Filter Bulan --</option>
                <option value="1" <%= selectedBulan == '1' ? 'selected' : '' %>>Januari</option>
                <option value="2" <%= selectedBulan == '2' ? 'selected' : '' %>>Februari</option>
                <option value="3" <%= selectedBulan == '3' ? 'selected' : '' %>>Maret</option>
                <option value="4" <%= selectedBulan == '4' ? 'selected' : '' %>>April</option>
                <option value="5" <%= selectedBulan == '5' ? 'selected' : '' %>>Mei</option>
                <option value="6" <%= selectedBulan == '6' ? 'selected' : '' %>>Juni</option>
                <option value="7" <%= selectedBulan == '7' ? 'selected' : '' %>>Juli</option>
                <option value="8" <%= selectedBulan == '8' ? 'selected' : '' %>>Agustus</option>
                <option value="9" <%= selectedBulan == '9' ? 'selected' : '' %>>September</option>
                <option value="10" <%= selectedBulan == '10' ? 'selected' : '' %>>Oktober</option>
                <option value="11" <%= selectedBulan == '11' ? 'selected' : '' %>>November</option>
                <option value="12" <%= selectedBulan == '12' ? 'selected' : '' %>>Desember</option>
            </select>
            <input type="number" name="tahun" value="<%= selectedTahun %>" class="p-1.5 text-xs border border-slate-300 rounded w-20 focus:outline-none">
            <button type="submit" class="px-3 py-1.5 bg-brandBlue text-white font-bold text-xs rounded hover:bg-blue-800 transition">Filter</button>
            
            <% if(showAll) { %>
                <a href="/dashboard" class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded transition">1 Bulan Terakhir</a>
            <% } else { %>
                <a href="/dashboard?show_all=true" class="px-3 py-1.5 bg-amber-100 hover:bg-amber-200 text-amber-900 font-bold text-xs rounded transition">Lihat Semua Riwayat</a>
            <% } %>
        </form>
    </div>

    <!-- Navigation Tabs Kategori -->
    <div class="flex border-b border-slate-200 mb-4 gap-2">
        <button onclick="switchTab('pending')" id="tab-pending" class="px-4 py-2 font-bold text-xs sm:text-sm border-b-2 border-brandBlue text-brandBlue">
            Menunggu Approval (<%= pendingList.length %>)
        </button>
        <button onclick="switchTab('approved')" id="tab-approved" class="px-4 py-2 font-bold text-xs sm:text-sm border-b-2 border-transparent text-slate-500 hover:text-slate-700">
            Sedang Dipinjam (<%= approvedList.length %>)
        </button>
        <button onclick="switchTab('finished')" id="tab-finished" class="px-4 py-2 font-bold text-xs sm:text-sm border-b-2 border-transparent text-slate-500 hover:text-slate-700">
            Selesai / Ditolak (<%= finishedList.length %>)
        </button>
    </div>

    <!-- TAB 1: PENDING -->
    <div id="content-pending" class="overflow-x-auto">
        <table class="w-full text-left text-xs sm:text-sm text-slate-600">
            <thead class="bg-slate-100 text-slate-700 uppercase text-[10px] sm:text-xs">
                <tr>
                    <th class="p-2 sm:p-3">Peminjam</th>
                    <th class="p-2 sm:p-3">Seksi / Unit</th>
                    <th class="p-2 sm:p-3">Mobil</th>
                    <th class="p-2 sm:p-3">Tujuan</th>
                    <th class="p-2 sm:p-3">Durasi</th>
                    <th class="p-2 sm:p-3">Ubah Status</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
                <% if (pendingList.length === 0) { %>
                    <tr><td colspan="6" class="p-4 text-center text-xs text-slate-400">Tidak ada peminjaman yang menunggu persetujuan.</td></tr>
                <% } %>
                <% pendingList.forEach(p => { %>
                <tr>
                    <td class="p-2 sm:p-3 font-medium text-slate-900 whitespace-nowrap"><%= p.nama_user %><br><span class="text-[10px] text-slate-400">@<%= p.username %></span></td>
                    <td class="p-2 sm:p-3 font-semibold text-slate-700"><%= p.nama_seksi || '-' %></td>
                    <td class="p-2 sm:p-3 font-semibold text-brandBlue whitespace-nowrap"><%= p.merk_tipe %><br><span class="text-[10px] font-mono text-slate-500"><%= p.plat_nomor %></span></td>
                    <td class="p-2 sm:p-3"><%= p.tujuan_peminjaman %></td>
                    <td class="p-2 sm:p-3 whitespace-nowrap"><p><%= p.lama_pinjam_hari %> Hari</p><p class="text-[10px] text-slate-400"><%= new Date(p.tgl_mulai).toLocaleDateString('id-ID') %> - <%= new Date(p.tgl_selesai).toLocaleDateString('id-ID') %></p></td>
                    <td class="p-2 sm:p-3 whitespace-nowrap">
                        <form action="/dashboard/admin/peminjaman/status" method="POST" class="flex items-center gap-1">
                            <input type="hidden" name="peminjaman_id" value="<%= p.id %>">
                            <input type="hidden" name="mobil_id" value="<%= p.mobil_id %>">
                            <select name="status_peminjaman" class="text-xs p-1 border border-slate-300 rounded bg-white focus:outline-none">
                                <option value="PENDING" selected>PENDING</option>
                                <option value="APPROVED">APPROVED</option>
                                <option value="REJECTED">REJECTED</option>
                            </select>
                            <button type="submit" class="px-2 py-1 bg-brandBlue text-white text-xs rounded font-bold">Simpan</button>
                        </form>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <!-- TAB 2: APPROVED -->
    <div id="content-approved" class="overflow-x-auto hidden">
        <table class="w-full text-left text-xs sm:text-sm text-slate-600">
            <thead class="bg-slate-100 text-slate-700 uppercase text-[10px] sm:text-xs">
                <tr>
                    <th class="p-2 sm:p-3">Peminjam</th>
                    <th class="p-2 sm:p-3">Seksi / Unit</th>
                    <th class="p-2 sm:p-3">Mobil</th>
                    <th class="p-2 sm:p-3">Tujuan</th>
                    <th class="p-2 sm:p-3">Durasi</th>
                    <th class="p-2 sm:p-3">Ubah Status</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
                <% if (approvedList.length === 0) { %>
                    <tr><td colspan="6" class="p-4 text-center text-xs text-slate-400">Tidak ada mobil yang sedang dipinjam.</td></tr>
                <% } %>
                <% approvedList.forEach(p => { %>
                <tr>
                    <td class="p-2 sm:p-3 font-medium text-slate-900 whitespace-nowrap"><%= p.nama_user %><br><span class="text-[10px] text-slate-400">@<%= p.username %></span></td>
                    <td class="p-2 sm:p-3 font-semibold text-slate-700"><%= p.nama_seksi || '-' %></td>
                    <td class="p-2 sm:p-3 font-semibold text-brandBlue whitespace-nowrap"><%= p.merk_tipe %><br><span class="text-[10px] font-mono text-slate-500"><%= p.plat_nomor %></span></td>
                    <td class="p-2 sm:p-3"><%= p.tujuan_peminjaman %></td>
                    <td class="p-2 sm:p-3 whitespace-nowrap"><p><%= p.lama_pinjam_hari %> Hari</p><p class="text-[10px] text-slate-400"><%= new Date(p.tgl_mulai).toLocaleDateString('id-ID') %> - <%= new Date(p.tgl_selesai).toLocaleDateString('id-ID') %></p></td>
                    <td class="p-2 sm:p-3 whitespace-nowrap">
                        <form action="/dashboard/admin/peminjaman/status" method="POST" class="flex items-center gap-1">
                            <input type="hidden" name="peminjaman_id" value="<%= p.id %>">
                            <input type="hidden" name="mobil_id" value="<%= p.mobil_id %>">
                            <select name="status_peminjaman" class="text-xs p-1 border border-slate-300 rounded bg-white focus:outline-none">
                                <option value="APPROVED" selected>APPROVED</option>
                                <option value="RETURNED">RETURNED</option>
                            </select>
                            <button type="submit" class="px-2 py-1 bg-brandBlue text-white text-xs rounded font-bold">Simpan</button>
                        </form>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>

    <!-- TAB 3: FINISHED / REJECTED -->
    <div id="content-finished" class="overflow-x-auto hidden">
        <table class="w-full text-left text-xs sm:text-sm text-slate-600">
            <thead class="bg-slate-100 text-slate-700 uppercase text-[10px] sm:text-xs">
                <tr>
                    <th class="p-2 sm:p-3">Peminjam</th>
                    <th class="p-2 sm:p-3">Seksi / Unit</th>
                    <th class="p-2 sm:p-3">Mobil</th>
                    <th class="p-2 sm:p-3">Tujuan</th>
                    <th class="p-2 sm:p-3">Durasi</th>
                    <th class="p-2 sm:p-3">Status Akhir</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
                <% if (finishedList.length === 0) { %>
                    <tr><td colspan="6" class="p-4 text-center text-xs text-slate-400">Belum ada riwayat peminjaman selesai/ditolak.</td></tr>
                <% } %>
                <% finishedList.forEach(p => { %>
                <tr>
                    <td class="p-2 sm:p-3 font-medium text-slate-900 whitespace-nowrap"><%= p.nama_user %><br><span class="text-[10px] text-slate-400">@<%= p.username %></span></td>
                    <td class="p-2 sm:p-3 font-semibold text-slate-700"><%= p.nama_seksi || '-' %></td>
                    <td class="p-2 sm:p-3 font-semibold text-brandBlue whitespace-nowrap"><%= p.merk_tipe %><br><span class="text-[10px] font-mono text-slate-500"><%= p.plat_nomor %></span></td>
                    <td class="p-2 sm:p-3"><%= p.tujuan_peminjaman %></td>
                    <td class="p-2 sm:p-3 whitespace-nowrap"><p><%= p.lama_pinjam_hari %> Hari</p><p class="text-[10px] text-slate-400"><%= new Date(p.tgl_mulai).toLocaleDateString('id-ID') %> - <%= new Date(p.tgl_selesai).toLocaleDateString('id-ID') %></p></td>
                    <td class="p-2 sm:p-3 whitespace-nowrap">
                        <% if(p.status_peminjaman === 'RETURNED') { %>
                            <span class="px-2 py-0.5 text-[10px] sm:text-xs font-bold rounded-full bg-slate-100 text-slate-700">RETURNED</span>
                        <% } else { %>
                            <span class="px-2 py-0.5 text-[10px] sm:text-xs font-bold rounded-full bg-rose-100 text-rose-800">REJECTED</span>
                        <% } %>
                    </td>
                </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Pop-Up Edit Mobil -->
<div id="editModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center z-50 p-3 sm:p-4">
    <div class="bg-white rounded-xl max-w-lg w-full p-4 sm:p-6 shadow-xl border border-slate-200 max-h-[90vh] overflow-y-auto">
        <div class="flex justify-between items-center mb-4 border-b pb-3">
            <h3 class="text-base sm:text-lg font-bold text-brandBlue">Edit Data Mobil</h3>
            <button type="button" onclick="closeEditModal()" class="text-slate-400 hover:text-slate-600 font-bold text-xl">&times;</button>
        </div>
        <form action="/dashboard/mobil/edit" method="POST" class="space-y-3">
            <input type="hidden" id="edit_mobil_id" name="mobil_id">
            
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Plat Nomor</label>
                <input type="text" id="edit_plat_nomor" name="plat_nomor" required class="w-full p-2 text-xs border border-slate-300 rounded focus:outline-none focus:border-brandBlue">
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Merek & Tipe</label>
                <input type="text" id="edit_merk_tipe" name="merk_tipe" required class="w-full p-2 text-xs border border-slate-300 rounded focus:outline-none focus:border-brandBlue">
            </div>
            <div class="grid grid-cols-2 gap-2">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Kategori</label>
                    <input type="text" id="edit_kategori" name="kategori" required class="w-full p-2 text-xs border border-slate-300 rounded focus:outline-none focus:border-brandBlue">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Kapasitas (Seat)</label>
                    <input type="number" id="edit_kapasitas" name="kapasitas" required class="w-full p-2 text-xs border border-slate-300 rounded focus:outline-none focus:border-brandBlue">
                </div>
            </div>
            <div class="grid grid-cols-2 gap-2">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Tahun Pembuatan</label>
                    <input type="number" id="edit_tahun" name="tahun" required class="w-full p-2 text-xs border border-slate-300 rounded focus:outline-none focus:border-brandBlue">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Status Mobil</label>
                    <select id="edit_status" name="status" class="w-full p-2 text-xs border border-slate-300 rounded focus:outline-none focus:border-brandBlue bg-white">
                        <option value="FREE">FREE</option>
                        <option value="DIPINJAM">DIPINJAM</option>
                        <option value="MAINTENANCE">MAINTENANCE</option>
                    </select>
                </div>
            </div>
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">Catatan Kondisi</label>
                <input type="text" id="edit_kondapat_catatan" name="kondapat_catatan" class="w-full p-2 text-xs border border-slate-300 rounded focus:outline-none focus:border-brandBlue">
            </div>

            <div class="pt-3 flex justify-end gap-2 border-t">
                <button type="button" onclick="closeEditModal()" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-lg transition">Batal</button>
                <button type="submit" class="px-4 py-2 bg-brandBlue hover:bg-blue-800 text-white font-bold text-xs rounded-lg transition">Simpan Perubahan</button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Admin Cek Jadwal & Kalender -->
<div id="adminJadwalModal" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm hidden items-center justify-center z-50 p-3 sm:p-4">
    <div class="bg-white rounded-xl max-w-lg w-full p-4 sm:p-6 shadow-xl border border-slate-200 max-h-[85vh] overflow-y-auto">
        <div class="flex justify-between items-center mb-4 border-b pb-3">
            <div class="min-w-0 pr-2">
                <h3 id="adminJadwalTitle" class="text-base sm:text-lg font-bold text-brandBlue truncate"></h3>
                <p id="adminJadwalPlat" class="text-xs text-slate-500 font-mono"></p>
            </div>
            <button type="button" onclick="closeAdminJadwalModal()" class="text-slate-400 hover:text-slate-600 font-bold text-xl">&times;</button>
        </div>

        <div class="space-y-4">
            <div class="p-3 bg-slate-50 border border-slate-200 rounded-lg">
                <label class="block text-xs font-bold text-slate-700 mb-2">📅 Visualisasi Kalender Booking:</label>
                <input type="text" id="adminCalendarView" placeholder="Melihat Tanggal Ter-booking" class="w-full p-2 text-xs border border-slate-300 rounded bg-white cursor-pointer" readonly>
            </div>

            <div>
                <h4 class="text-xs font-bold text-slate-700 uppercase mb-2">📌 Daftar Rincian Peminjam:</h4>
                <div id="adminJadwalList" class="space-y-2">
                    <p class="text-xs text-slate-400">Memuat data jadwal...</p>
                </div>
            </div>
        </div>

        <div class="mt-6 pt-3 border-t flex justify-end">
            <button type="button" onclick="closeAdminJadwalModal()" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs rounded-lg transition">Tutup</button>
        </div>
    </div>
</div>

<script>
let fpAdmin;

function switchTab(category) {
    const categories = ['pending', 'approved', 'finished'];
    categories.forEach(cat => {
        const tabBtn = document.getElementById(`tab-${cat}`);
        const contentDiv = document.getElementById(`content-${cat}`);
        if (cat === category) {
            tabBtn.classList.add('border-brandBlue', 'text-brandBlue');
            tabBtn.classList.remove('border-transparent', 'text-slate-500');
            contentDiv.classList.remove('hidden');
        } else {
            tabBtn.classList.remove('border-brandBlue', 'text-brandBlue');
            tabBtn.classList.add('border-transparent', 'text-slate-500');
            contentDiv.classList.add('hidden');
        }
    });
}

function openEditModal(btn) {
    document.getElementById('edit_mobil_id').value = btn.getAttribute('data-id');
    document.getElementById('edit_plat_nomor').value = btn.getAttribute('data-plat');
    document.getElementById('edit_merk_tipe').value = btn.getAttribute('data-merk');
    document.getElementById('edit_kategori').value = btn.getAttribute('data-kategori');
    document.getElementById('edit_kapasitas').value = btn.getAttribute('data-kapasitas');
    document.getElementById('edit_tahun').value = btn.getAttribute('data-tahun');
    document.getElementById('edit_status').value = btn.getAttribute('data-status');
    document.getElementById('edit_kondapat_catatan').value = btn.getAttribute('data-catatan');

    document.body.classList.add('overflow-hidden');
    const modal = document.getElementById('editModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
}

function closeEditModal() {
    document.body.classList.remove('overflow-hidden');
    const modal = document.getElementById('editModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
}

function openAdminJadwalModal(mobilId, merk, plat) {
    document.getElementById('adminJadwalTitle').innerText = merk;
    document.getElementById('adminJadwalPlat').innerText = plat;

    const container = document.getElementById('adminJadwalList');
    container.innerHTML = '<p class="text-xs text-slate-400">Memuat data jadwal...</p>';

    fetch(`/dashboard/mobil/${mobilId}/jadwal`)
        .then(res => res.json())
        .then(data => {
            const disableRanges = [];
            data.forEach(item => {
                disableRanges.push({
                    from: item.tgl_mulai.split('T')[0],
                    to: item.tgl_selesai.split('T')[0]
                });
            });

            if (fpAdmin) fpAdmin.destroy();
            fpAdmin = flatpickr("#adminCalendarView", {
                inline: false,
                dateFormat: "Y-m-d",
                disable: disableRanges,
                onDayCreate: function(dObj, dStr, fp, dayElem) {
                    const dayDate = dayElem.dateObj;
                    disableRanges.forEach(range => {
                        const start = new Date(range.from);
                        const end = new Date(range.to);
                        start.setHours(0,0,0,0);
                        end.setHours(23,59,59,999);
                        if (dayDate >= start && dayDate <= end) {
                            dayElem.classList.add("booked-date");
                            dayElem.title = "Sudah ter-booking";
                        }
                    });
                }
            });

            if (data.length === 0) {
                container.innerHTML = '<div class="p-3 bg-emerald-50 text-emerald-800 rounded-lg text-xs">Belum ada peminjaman terdaftar pada unit ini.</div>';
                return;
            }
            let html = '';
            data.forEach(item => {
                const tglStart = new Date(item.tgl_mulai).toLocaleDateString('id-ID', { day: '2-digit', month: '2-digit', year: 'numeric' });
                const tglEnd = new Date(item.tgl_selesai).toLocaleDateString('id-ID', { day: '2-digit', month: '2-digit', year: 'numeric' });
                const badgeColor = item.status_peminjaman === 'APPROVED' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800';

                html += `
                    <div class="p-3 border border-slate-200 bg-slate-50 rounded-lg text-xs space-y-1">
                        <div class="flex justify-between items-center gap-2">
                            <span class="font-bold text-slate-900 truncate">${item.nama_peminjam} (${item.nama_seksi || '-'})</span>
                            <span class="px-2 py-0.5 text-[10px] font-bold rounded-full ${badgeColor} shrink-0">${item.status_peminjaman}</span>
                        </div>
                        <p class="text-slate-600 break-words"><strong>Tujuan:</strong> ${item.tujuan_peminjaman}</p>
                        <p class="text-brandBlue font-semibold">📅 ${tglStart} s/d ${tglEnd}</p>
                    </div>
                `;
            });
            container.innerHTML = html;
        });

    document.body.classList.add('overflow-hidden');
    const modal = document.getElementById('adminJadwalModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
}

function closeAdminJadwalModal() {
    document.body.classList.remove('overflow-hidden');
    const modal = document.getElementById('adminJadwalModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
}
</script>

<%- include('partials/footer') %>